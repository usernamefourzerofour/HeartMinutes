    "Tap ⓘ to see what a setting does. %@ appears when a setting has been changed – tap it to reset the setting to its default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ⓘ لمعرفة وظيفة الإعداد. يظهر %@ عند تغيير إعداد – اضغط عليه لإعادته إلى الافتراضي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете ⓘ, за да видите какво прави настройката. %@ се появява, когато настройка е променена – докоснете го, за да върнете стойността по подразбиране."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ⓘ per veure què fa un ajust. %@ apareix quan s’ha canviat un ajust; toca’l per tornar al valor per defecte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na ⓘ zjistíte, co nastavení dělá. %@ se zobrazí, když bylo nastavení změněno – klepnutím ho vrátíte na výchozí hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⓘ for at se, hvad en indstilling gør. %@ vises, når en indstilling er ændret – tryk på den for at sætte indstillingen tilbage til standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ⓘ, um zu sehen, was eine Einstellung bewirkt. %@ erscheint, wenn eine Einstellung geändert wurde – tippe darauf, um sie auf den Standard zurückzusetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε το ⓘ για να δείτε τι κάνει μια ρύθμιση. Το %@ εμφανίζεται όταν μια ρύθμιση έχει αλλάξει – αγγίξτε το για επαναφορά στην προεπιλογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ⓘ para ver qué hace un ajuste. %@ aparece cuando un ajuste se ha cambiado; tócalo para volver al valor predeterminado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ⓘ para ver qué hace un ajuste. %@ aparece cuando un ajuste se ha cambiado; tócalo para volver al valor predeterminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta ⓘ nähdäksesi, mitä asetus tekee. %@ näkyy, kun asetusta on muutettu – napauta sitä palauttaaksesi oletuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ⓘ pour voir ce que fait un réglage. %@ apparaît lorsqu’un réglage a été modifié – touchez-le pour revenir à la valeur par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על ⓘ כדי לראות מה הגדרה עושה. %@ מופיע כשהגדרה שונתה – הקישו עליו כדי להחזיר לברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सेटिंग क्या करती है, यह देखने के लिए ⓘ पर टैप करें। सेटिंग बदलने पर %@ दिखता है – डिफ़ॉल्ट पर लौटाने के लिए उस पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite ⓘ da vidite što postavka radi. %@ se pojavljuje kad je postavka promijenjena – dodirnite ga da vratite zadano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson az ⓘ-re, hogy lássa, mit csinál egy beállítás. A %@ akkor jelenik meg, ha egy beállítás módosult – koppintson rá az alapértelmezés visszaállításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ⓘ untuk melihat fungsi pengaturan. %@ muncul saat pengaturan diubah – ketuk untuk mengembalikan ke default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ⓘ per vedere cosa fa un’impostazione. %@ compare quando un’impostazione è stata modificata – toccalo per ripristinare il valore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ⓘをタップすると設定の説明が表示されます。設定を変更すると%@が表示され、タップするとデフォルトに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ⓘ를 탭하면 설정의 기능을 볼 수 있습니다. 설정을 변경하면 %@이(가) 표시되며, 탭하면 기본값으로 돌아갑니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite ⓘ, kad sužinotumėte, ką daro nustatymas. %@ rodomas, kai nustatymas pakeistas – bakstelėkite jį, kad grąžintumėte numatytąjį."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ⓘ untuk melihat fungsi sesuatu seting. %@ muncul apabila seting telah diubah – ketik untuk kembali kepada lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ⓘ for å se hva en innstilling gjør. %@ vises når en innstilling er endret – trykk på den for å sette den tilbake til standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ⓘ om te zien wat een instelling doet. %@ verschijnt als een instelling is gewijzigd – tik erop om die terug te zetten naar de standaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ⓘ, aby zobaczyć, co robi ustawienie. %@ pojawia się, gdy ustawienie zostało zmienione – stuknij, aby przywrócić wartość domyślną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ⓘ para ver o que um ajuste faz. %@ aparece quando um ajuste foi alterado – toque nele para voltar ao padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ⓘ para ver o que faz uma definição. %@ aparece quando uma definição foi alterada – toque nele para repor a predefinição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ⓘ pentru a vedea ce face o configurare. %@ apare când o configurare a fost modificată – atingeți-l pentru a reveni la valoarea implicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ⓘ, чтобы узнать, что делает настройка. %@ появляется, когда настройка изменена, — коснитесь его, чтобы вернуть значение по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na ⓘ zistíte, čo nastavenie robí. %@ sa zobrazí, keď bolo nastavenie zmenené – klepnutím ho vrátite na predvolenú hodnotu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite ⓘ, da vidite, kaj nastavitev naredi. %@ se prikaže, ko je nastavitev spremenjena – tapnite ga, da povrnete privzeto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ⓘ för att se vad en inställning gör. %@ visas när en inställning har ändrats – tryck på den för att återställa standardvärdet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ⓘ เพื่อดูว่าการตั้งค่าทำอะไร %@ จะแสดงเมื่อมีการเปลี่ยนการตั้งค่า – แตะเพื่อคืนค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayarın ne yaptığını görmek için ⓘ’ye dokunun. Bir ayar değiştirildiğinde %@ görünür – varsayılana döndürmek için ona dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ⓘ, щоб дізнатися, що робить налаштування. %@ зʼявляється, коли налаштування змінено, — торкніться його, щоб повернути типове значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ⓘ để xem cài đặt làm gì. %@ xuất hiện khi một cài đặt đã thay đổi – chạm vào để đặt lại về mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 ⓘ 查看设置的作用。设置被更改后会显示 %@——轻点即可恢复为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ⓘ 查看設定的作用。設定變更後會顯示 %@——點一下即可恢復預設值。"
          }
        }
      }
    },
