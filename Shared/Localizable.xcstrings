        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy sa počíta váš tep počas dňa (mimo tréningov):"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdaj se šteje vaš srčni utrip čez dan (zunaj vadb):"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din puls under dagen (utanför träningspass) räknas:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรระหว่างวันของคุณ (นอกการออกกำลังกาย) นับเมื่อใด:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün içindeki nabzınız (antrenman dışında) ne zaman sayılır:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли враховується ваш пульс протягом дня (поза тренуваннями):"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nào nhịp tim trong ngày (ngoài bài tập) được tính:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常（体能训练之外）心率何时计入："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日常（體能訓練以外）心率何時計入："
          }
        }
      }
    },
    "When your heart rate during the day – outside workouts – counts as Heart Minutes. Workouts always count.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يُحتسب نبضك خلال اليوم – خارج التمارين – كـ Heart Minutes. التمارين تُحتسب دائمًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога пулсът ви през деня – извън тренировки – се брои като Heart Minutes. Тренировките се броят винаги."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan compta la teva freqüència durant el dia, fora dels entrenaments, com a Heart Minutes. Els entrenaments sempre compten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy se váš tep během dne – mimo tréninky – počítá jako Heart Minutes. Tréninky se počítají vždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår din puls i løbet af dagen – uden for workouts – tæller som Heart Minutes. Workouts tæller altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann deine Herzfrequenz tagsüber – außerhalb von Trainings – als Heart Minutes zählt. Trainings zählen immer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε οι παλμοί σας κατά την ημέρα – εκτός προπονήσεων – μετρούν ως Heart Minutes. Οι προπονήσεις μετρούν πάντα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo cuenta tu frecuencia cardiaca durante el día, fuera de los entrenamientos, como Heart Minutes. Los entrenamientos siempre cuentan."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo cuenta tu frecuencia cardiaca durante el día, fuera de los entrenamientos, como Heart Minutes. Los entrenamientos siempre cuentan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin päivän aikainen sykkeesi – treenien ulkopuolella – lasketaan Heart Minutesiksi. Treenit lasketaan aina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand votre fréquence cardiaque de la journée – hors entraînements – compte comme Heart Minutes. Les entraînements comptent toujours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתי הדופק שלך במהלך היום – מחוץ לאימונים – נספר כ־Heart Minutes. אימונים נספרים תמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में – वर्कआउट के बाहर – आपकी हृदय गति कब Heart Minutes के रूप में गिनी जाती है। वर्कआउट हमेशा गिने जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada se vaš puls tijekom dana – izvan treninga – broji kao Heart Minutes. Treninzi se uvijek broje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor számít a napközbeni pulzusa – edzésen kívül – Heart Minutesnek. Az edzések mindig számítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan detak jantung Anda sepanjang hari – di luar olahraga – dihitung sebagai Heart Minutes. Olahraga selalu dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la frequenza cardiaca durante il giorno – fuori dagli allenamenti – conta come Heart Minutes. Gli allenamenti contano sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日中（ワークアウト以外）の心拍数がHeart Minutesとしてカウントされる条件。ワークアウトは常にカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 중(운동 외) 심박수가 Heart Minutes로 계산되는 경우입니다. 운동은 항상 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada jūsų pulsas dienos metu – ne treniruočių metu – įskaičiuojamas kaip Heart Minutes. Treniruotės įskaičiuojamos visada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila kadar denyutan jantung anda sepanjang hari – di luar senaman – dikira sebagai Heart Minutes. Senaman sentiasa dikira."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når pulsen din i løpet av dagen – utenfor treningsøkter – teller som Heart Minutes. Treningsøkter teller alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je hartslag overdag – buiten trainingen – als Heart Minutes telt. Trainingen tellen altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy Twoje tętno w ciągu dnia – poza treningami – liczy się jako Heart Minutes. Treningi liczą się zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sua frequência cardíaca durante o dia – fora dos treinos – conta como Heart Minutes. Treinos sempre contam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a sua frequência durante o dia – fora dos treinos – conta como Heart Minutes. Os treinos contam sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când pulsul din timpul zilei – în afara antrenamentelor – contează ca Heart Minutes. Antrenamentele contează mereu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ваш пульс в течение дня — вне тренировок — засчитывается как Heart Minutes. Тренировки учитываются всегда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy sa váš tep počas dňa – mimo tréningov – počíta ako Heart Minutes. Tréningy sa počítajú vždy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdaj se vaš srčni utrip čez dan – zunaj vadb – šteje kot Heart Minutes. Vadbe se vedno štejejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din puls under dagen – utanför träningspass – räknas som Heart Minutes. Träningspass räknas alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรระหว่างวันของคุณ – นอกการออกกำลังกาย – นับเป็น Heart Minutes เมื่อใด การออกกำลังกายนับเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün içindeki nabzınız – antrenman dışında – ne zaman Heart Minutes olarak sayılır. Antrenmanlar her zaman sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ваш пульс протягом дня — поза тренуваннями — зараховується як Heart Minutes. Тренування враховуються завжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nào nhịp tim trong ngày – ngoài bài tập – được tính là Heart Minutes. Bài tập luôn được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常（体能训练之外）心率何时计为 Heart Minutes。体能训练始终计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日常（體能訓練以外）心率何時計為 Heart Minutes。體能訓練一律計入。"
          }
        }
      }
    },
    "Which heart rate measurements count towards Heart Minutes and are shown in the heart rate chart.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قياسات النبض التي تُحتسب في Heart Minutes وتظهر في مخطط النبض."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кои измервания на пулса се броят в Heart Minutes и се показват в графиката."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quines mesures de freqüència compten per a Heart Minutes i es mostren al gràfic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Která měření tepu se počítají do Heart Minutes a zobrazují v grafu tepu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke pulsmålinger der tæller med i Heart Minutes og vises i pulsgrafen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Herzfrequenzmessungen in Heart Minutes zählen und in der Grafik erscheinen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιες μετρήσεις παλμών μετρούν στα Heart Minutes και εμφανίζονται στο γράφημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué mediciones de frecuencia cuentan para Heart Minutes y se muestran en la gráfica."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué mediciones de frecuencia cuentan para Heart Minutes y se muestran en la gráfica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitkä sykemittaukset lasketaan Heart Minutesiin ja näytetään sykekaaviossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures cardiaques qui comptent dans Heart Minutes et apparaissent dans le graphique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אילו מדידות דופק נספרות ב־Heart Minutes ומוצגות בגרף הדופק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-से हृदय गति माप Heart Minutes में गिने जाते हैं और ग्राफ़ में दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koja se mjerenja pulsa broje u Heart Minutes i prikazuju na grafikonu pulsa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mely pulzusmérések számítanak a Heart Minutesbe, és jelennek meg a grafikonon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran detak jantung mana yang dihitung dalam Heart Minutes dan ditampilkan di grafik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali misurazioni contano per Heart Minutes e compaiono nel grafico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutesにカウントされ、心拍数グラフに表示される測定値。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes에 계산되고 심박수 그래프에 표시되는 측정값입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurie pulso matavimai įskaičiuojami į Heart Minutes ir rodomi pulso grafike."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran kadar denyutan jantung yang dikira dalam Heart Minutes dan dipaparkan dalam graf."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke pulsmålinger som teller i Heart Minutes og vises i pulsgrafen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke hartslagmetingen meetellen voor Heart Minutes en in de grafiek worden getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Które pomiary tętna liczą się do Heart Minutes i są widoczne na wykresie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais medições contam para o Heart Minutes e aparecem no gráfico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Que medições de frequência contam para o Heart Minutes e aparecem no gráfico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce măsurători ale pulsului se iau în calcul în Heart Minutes și apar în grafic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие измерения пульса учитываются в Heart Minutes и показываются на графике."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoré merania tepu sa počítajú do Heart Minutes a zobrazujú v grafe tepu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katere meritve srčnega utripa se štejejo v Heart Minutes in so prikazane na grafu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka pulsmätningar som räknas i Heart Minutes och visas i pulsdiagrammet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวัดชีพจรใดที่นับใน Heart Minutes และแสดงในกราฟชีพจร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi nabız ölçümlerinin Heart Minutes’a sayıldığı ve grafikte gösterildiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Які вимірювання пульсу враховуються в Heart Minutes і показуються на графіку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những số đo nhịp tim nào được tính vào Heart Minutes và hiển thị trên biểu đồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些心率测量计入 Heart Minutes 并显示在心率图中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些心率測量會計入 Heart Minutes 並顯示在心率圖中。"
          }
        }
      }
