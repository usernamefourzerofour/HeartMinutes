    "When your heart rate during the day (outside workouts) counts:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يُحتسب نبضك خلال اليوم (خارج التمارين):"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога се брои пулсът ви през деня (извън тренировки):"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan compta la teva freqüència durant el dia (fora dels entrenaments):"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy se počítá váš tep během dne (mimo tréninky):"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår din puls i løbet af dagen (uden for workouts) tæller med:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann deine Herzfrequenz tagsüber (außerhalb von Trainings) zählt:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε μετρούν οι παλμοί σας κατά τη διάρκεια της ημέρας (εκτός προπονήσεων):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo cuenta tu frecuencia cardiaca durante el día (fuera de los entrenamientos):"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo cuenta tu frecuencia cardiaca durante el día (fuera de los entrenamientos):"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Milloin päivän aikainen sykkeesi (treenien ulkopuolella) lasketaan:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand votre fréquence cardiaque de la journée (hors entraînements) compte :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתי הדופק שלך במהלך היום (מחוץ לאימונים) נספר:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में (वर्कआउट के बाहर) आपकी हृदय गति कब गिनी जाती है:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada se broji vaš puls tijekom dana (izvan treninga):"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor számít a napközbeni pulzusa (edzésen kívül):"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan detak jantung Anda sepanjang hari (di luar olahraga) dihitung:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando conta la frequenza cardiaca durante il giorno (fuori dagli allenamenti):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日中（ワークアウト以外）の心拍数がカウントされる条件："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 중(운동 외) 심박수가 계산되는 경우:"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada įskaičiuojamas jūsų pulsas dienos metu (ne treniruočių metu):"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila kadar denyutan jantung anda sepanjang hari (di luar senaman) dikira:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når pulsen din i løpet av dagen (utenfor treningsøkter) teller:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je hartslag overdag (buiten trainingen) meetelt:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy liczy się Twoje tętno w ciągu dnia (poza treningami):"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sua frequência cardíaca durante o dia (fora dos treinos) conta:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando conta a sua frequência cardíaca durante o dia (fora dos treinos):"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când se ia în calcul pulsul din timpul zilei (în afara antrenamentelor):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда учитывается ваш пульс в течение дня (вне тренировок):"
