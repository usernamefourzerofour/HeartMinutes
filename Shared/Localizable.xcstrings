            "value": "Poista ”Vain aktiivisena”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver « Seulement si actif »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי ״רק כשפעיל״"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“केवल सक्रिय होने पर” बंद करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi „Samo kad je aktivno”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Csak aktív állapotban” kikapcsolása"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan “Hanya saat aktif”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva «Solo se attivo»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクティブ時のみ」をオフ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘활동 중일 때만’ 끄기"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išjungti „Tik kai aktyvus“"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan “Hanya semasa aktif”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av «Bare når aktiv»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Alleen als actief’ uitzetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz „Tylko przy aktywności”"
          }
        },
        "pt-BR": {
