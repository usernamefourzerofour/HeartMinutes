        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjärtats kant fylls mot veckans mål, med minuter i mitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบหัวใจเติมไปยังเป้าหมายรายสัปดาห์ พร้อมนาทีตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbin kenarı haftalık hedefe doğru dolar; ortada dakika."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контур серця заповнюється до тижневої мети, хвилини в центрі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viền trái tim lấp đầy dần đến mục tiêu tuần, số phút ở giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心形边缘朝每周目标填充，中间显示分钟数。"
