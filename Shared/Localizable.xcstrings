    "Choose the period and whether the number is shown in minutes or percent of the goal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الفترة وما إذا كان الرقم يظهر بالدقائق أو كنسبة من الهدف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете периода и дали числото да е в минути, или в процент от целта."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria el període i si el número es mostra en minuts o en percentatge de l’objectiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte období a zda se číslo zobrazí v minutách, nebo v procentech cíle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg periode, og om tallet vises i minutter eller procent af målet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Zeitraum und ob die Zahl in Minuten oder Prozent des Ziels angezeigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε περίοδο και αν ο αριθμός εμφανίζεται σε λεπτά ή σε ποσοστό του στόχου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el periodo y si el número se muestra en minutos o en porcentaje del objetivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el periodo y si el número se muestra en minutos o en porcentaje del objetivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jakso ja näytetäänkö luku minuutteina vai prosentteina tavoitteesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la période et si le nombre s’affiche en minutes ou en pourcentage de l’objectif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תקופה והאם המספר יוצג בדקות או באחוזים מהיעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधि चुनें और यह कि संख्या मिनट में दिखे या लक्ष्य के प्रतिशत में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite razdoblje i prikazuje li se broj u minutama ili postotku cilja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az időszakot, és hogy a szám percben vagy a cél százalékában jelenjen meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih periode dan apakah angka ditampilkan dalam menit atau persen dari target."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il periodo e se il numero viene mostrato in minuti o in percentuale dell’obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間と、数値を分または目標に対するパーセントで表示するかを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간과 숫자를 분으로 표시할지 목표 대비 퍼센트로 표시할지 선택합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite laikotarpį ir ar skaičius rodomas minutėmis, ar tikslo procentais."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tempoh dan sama ada nombor dipaparkan dalam minit atau peratus sasaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg periode, og om tallet vises i minutter eller prosent av målet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de periode en of het getal in minuten of procent van het doel wordt getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz okres i czy liczba ma być w minutach, czy w procentach celu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o período e se o número aparece em minutos ou porcentagem da meta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o período e se o número aparece em minutos ou em percentagem do objetivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți perioada și dacă numărul apare în minute sau în procente din obiectiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите период и показывать ли число в минутах или в процентах от цели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte obdobie a či sa číslo zobrazí v minútach, alebo v percentách cieľa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite obdobje in ali je število prikazano v minutah ali v odstotkih cilja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj period och om talet visas i minuter eller procent av målet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกช่วงเวลา และให้แสดงตัวเลขเป็นนาทีหรือเปอร์เซ็นต์ของเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönemi ve sayının dakika mı yoksa hedefin yüzdesi olarak mı gösterileceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть період і чи показувати число в хвилинах або у відсотках від мети."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn khoảng thời gian và hiển thị số theo phút hay phần trăm mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时段，以及数字以分钟还是目标百分比显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇期間，以及數字以分鐘或目標百分比顯示。"
          }
        }
      }
    },
