          "stringUnit": {
            "state": "translated",
            "value": "Puls între măsurători"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс между измерениями"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tep medzi meraniami"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrip med meritvami"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls mellan mätningar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรระหว่างการวัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçümler arası nabız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс між вимірюваннями"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp tim giữa các số đo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量之间的心率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測量之間的心率"
          }
        }
      }
    },
    "Heart rate changes evenly between measurements; the time is split where it crosses a limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير النبض بانتظام بين القياسات؛ ويُقسم الوقت حيث يتجاوز حدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пулсът се променя равномерно между измерванията; времето се разделя там, където пресича граница."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La freqüència canvia de manera uniforme entre mesures; el temps es divideix on travessa un límit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tep se mezi měřeními mění rovnoměrně; čas se dělí tam, kde překročí hranici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen ændrer sig jævnt mellem målingerne; tiden deles, hvor den krydser en grænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz ändert sich gleichmäßig zwischen den Messungen; die Zeit wird dort geteilt, wo sie eine Grenze überschreitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παλμοί αλλάζουν ομαλά μεταξύ μετρήσεων· ο χρόνος χωρίζεται εκεί όπου περνούν ένα όριο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia cambia de forma uniforme entre mediciones; el tiempo se divide donde cruza un límite."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia cambia de forma uniforme entre mediciones; el tiempo se divide donde cruza un límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syke muuttuu tasaisesti mittausten välillä; aika jaetaan kohdassa, jossa se ylittää rajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence évolue régulièrement entre les mesures ; le temps est partagé là où elle franchit une limite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדופק משתנה באופן אחיד בין המדידות; הזמן מתחלק במקום שבו הוא חוצה גבול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मापों के बीच हृदय गति समान रूप से बदलती है; जहाँ यह सीमा पार करती है, वहाँ समय बँट जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls se ravnomjerno mijenja između mjerenja; vrijeme se dijeli ondje gdje prelazi granicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pulzus egyenletesen változik a mérések között; az idő ott oszlik meg, ahol átlép egy határt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung berubah merata di antara pengukuran; waktu dibagi di titik yang melewati batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza varia in modo uniforme tra le misurazioni; il tempo viene diviso dove attraversa un limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数は測定値の間で均等に変化するとみなし、境界を越える時点で時間を分けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박수가 측정값 사이에서 고르게 변한다고 보고, 경계를 넘는 지점에서 시간을 나눕니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsas tarp matavimų kinta tolygiai; laikas padalijamas ten, kur jis kerta ribą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar denyutan berubah secara sekata antara ukuran; masa dibahagikan di titik ia melepasi had."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen endrer seg jevnt mellom målingene; tiden deles der den krysser en grense."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hartslag verandert gelijkmatig tussen metingen; de tijd wordt gesplitst waar een grens wordt gekruist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tętno zmienia się równomiernie między pomiarami; czas jest dzielony tam, gdzie przekracza granicę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência muda de forma uniforme entre as medições; o tempo é dividido onde cruza um limite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência muda de forma uniforme entre medições; o tempo é dividido onde ultrapassa um limite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsul se schimbă uniform între măsurători; timpul se împarte acolo unde trece o limită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс равномерно меняется между измерениями; время делится там, где он пересекает границу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tep sa medzi meraniami mení rovnomerne; čas sa delí tam, kde prekročí hranicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrip se med meritvami enakomerno spreminja; čas se razdeli tam, kjer prečka mejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen ändras jämnt mellan mätningarna; tiden delas där den korsar en gräns."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรเปลี่ยนอย่างสม่ำเสมอระหว่างการวัด เวลาจะแบ่งตรงจุดที่ข้ามขอบเขต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabız ölçümler arasında düzgün değişir; süre, bir sınırı geçtiği yerde bölünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс рівномірно змінюється між вимірюваннями; час ділиться там, де він перетинає межу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp tim thay đổi đều giữa các số đo; thời gian được chia tại điểm vượt ngưỡng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率在两次测量之间均匀变化；在越过界限处分割时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心率在兩次測量之間均勻變化；在越過界限處分割時間。"
          }
        }
      }
    },
    "Heart rate is only measured now and then. Here you choose what the heart rate is assumed to be between two measurements:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقاس النبض من حين لآخر فقط. هنا تختار ما يُفترض أن يكون عليه النبض بين قياسين:"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пулсът се измерва само от време на време. Тук избирате какъв се приема пулсът между две измервания:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La freqüència només es mesura de tant en tant. Aquí tries quina freqüència se suposa entre dues mesures:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tep se měří jen občas. Zde volíte, jaký tep se předpokládá mezi dvěma měřeními:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen måles kun en gang imellem. Her vælger du, hvad pulsen antages at være mellem to målinger:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz wird nur ab und zu gemessen. Hier wählst du, welche Herzfrequenz zwischen zwei Messungen angenommen wird:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι παλμοί μετρώνται μόνο κατά διαστήματα. Εδώ επιλέγετε ποιοι θεωρούνται οι παλμοί μεταξύ δύο μετρήσεων:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia solo se mide de vez en cuando. Aquí eliges qué frecuencia se supone entre dos mediciones:"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia solo se mide de vez en cuando. Aquí eliges qué frecuencia se supone entre dos mediciones:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syke mitataan vain silloin tällöin. Tässä valitset, millaiseksi syke oletetaan kahden mittauksen välillä:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence n’est mesurée que de temps en temps. Choisissez ici la valeur supposée entre deux mesures :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדופק נמדד רק מדי פעם. כאן בוחרים מה מניחים לגבי הדופק בין שתי מדידות:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदय गति केवल कभी-कभी मापी जाती है। यहाँ आप चुनते हैं कि दो मापों के बीच हृदय गति क्या मानी जाए:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls se mjeri samo povremeno. Ovdje birate kakav se puls pretpostavlja između dva mjerenja:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pulzust csak időnként mérik. Itt választhatja ki, milyennek tekintsük a pulzust két mérés között:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung hanya diukur sesekali. Di sini Anda memilih detak jantung yang diasumsikan di antara dua pengukuran:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza viene misurata solo ogni tanto. Qui scegli quale frequenza si presume tra due misurazioni:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数はときどきしか測定されません。ここでは2つの測定値の間の心拍数をどう推定するかを選びます："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박수는 가끔씩만 측정됩니다. 여기서 두 측정값 사이의 심박수를 어떻게 추정할지 선택합니다:"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsas matuojamas tik retkarčiais. Čia pasirenkate, koks pulsas laikomas tarp dviejų matavimų:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar denyutan hanya diukur sekali-sekala. Di sini anda memilih kadar denyutan yang diandaikan antara dua ukuran:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen måles bare av og til. Her velger du hva pulsen antas å være mellom to målinger:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hartslag wordt maar af en toe gemeten. Hier kies je wat de hartslag tussen twee metingen wordt geacht te zijn:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tętno jest mierzone tylko od czasu do czasu. Tu wybierasz, jakie tętno przyjmuje się między dwoma pomiarami:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência só é medida de vez em quando. Aqui você escolhe qual frequência é presumida entre duas medições:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência só é medida de vez em quando. Aqui escolhe que frequência se assume entre duas medições:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsul se măsoară doar din când în când. Aici alegeți ce puls se presupune între două măsurători:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс измеряется лишь время от времени. Здесь вы выбираете, каким считать пульс между двумя измерениями:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tep sa meria len občas. Tu zvolíte, aký tep sa predpokladá medzi dvoma meraniami:"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrip se meri le občasno. Tu izberete, kakšen utrip se predpostavi med dvema meritvama:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsen mäts bara då och då. Här väljer du vad pulsen antas vara mellan två mätningar:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรถูกวัดเป็นครั้งคราวเท่านั้น ที่นี่คุณเลือกว่าจะสมมติชีพจรระหว่างการวัดสองครั้งอย่างไร:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabız yalnızca ara sıra ölçülür. Burada iki ölçüm arasındaki nabzın ne kabul edileceğini seçersiniz:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс вимірюється лише час від часу. Тут ви вибираєте, яким вважати пульс між двома вимірюваннями:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp tim chỉ được đo thỉnh thoảng. Tại đây bạn chọn nhịp tim được giả định giữa hai số đo:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率只会不时测量。在此选择两次测量之间的心率如何估算："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心率只會不時測量。在此選擇兩次測量之間的心率如何推估："
          }
        }
      }
    },
