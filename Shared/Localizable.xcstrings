          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif pendant les minutes comptées dans l’anneau Exercice (l’anneau vert – fréquence et mouvement)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעיל בדקות שנספרות בטבעת התרגול (הטבעת הירוקה – דופק ותנועה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन मिनटों में सक्रिय जो एक्सरसाइज़ रिंग में गिने जाते हैं (हरी रिंग – हृदय गति और गति)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno u minutama koje se broje u prstenu Vježbanje (zeleni prsten – puls i pokret)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív az edzésgyűrűbe számító percekben (a zöld gyűrű – pulzus és mozgás)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif pada menit yang dihitung di Cincin Latihan (cincin hijau – detak jantung dan gerakan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo nei minuti che contano nell’anello Esercizio (l’anello verde – frequenza e movimento)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクササイズリング（緑のリング：心拍数と動き）にカウントされる分はアクティブ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동하기 링(녹색 링 – 심박수와 움직임)에 계산되는 분에는 활동 중."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktyvus minutėmis, kurios įskaičiuojamos į treniruotės žiedą (žalias žiedas – pulsas ir judėjimas)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif dalam minit yang dikira dalam Gelang Senaman (gelang hijau – kadar denyutan dan pergerakan)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv i minuttene som teller i treningsringen (den grønne ringen – puls og bevegelse)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actief in de minuten die meetellen in de trainingsring (de groene ring – hartslag en beweging)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny w minutach liczonych w pierścieniu Ćwiczenia (zielony pierścień – tętno i ruch)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo nos minutos que contam no anel de Exercício (o anel verde – frequência e movimento)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo nos minutos que contam no Anel de Exercício (o anel verde – frequência e movimento)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activ în minutele care contează în inelul Exerciții (inelul verde – puls și mișcare)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен в минуты, засчитанные в кольцо «Упражнения» (зеленое кольцо — пульс и движение)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktívny v minútach, ktoré sa počítajú do krúžku Cvičenie (zelený krúžok – tep a pohyb)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno v minutah, ki štejejo v obroč Vadba (zeleni obroč – utrip in gibanje)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv under de minuter som räknas i träningsringen (den gröna ringen – puls och rörelse)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวในนาทีที่นับในวงแหวนออกกำลังกาย (วงแหวนสีเขียว – ชีพจรและการเคลื่อนไหว)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz halkasında sayılan dakikalarda etkin (yeşil halka – nabız ve hareket)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний у хвилини, зараховані в кільце «Вправи» (зелене кільце — пульс і рух)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động trong những phút được tính vào Vòng Bài tập (vòng xanh – nhịp tim và chuyển động)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在计入锻炼圆环（绿色圆环——心率与运动）的分钟内视为活跃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在計入運動圓圈（綠色圓圈——心率與動作）的分鐘內視為活動中。"
          }
        }
      }
    },
