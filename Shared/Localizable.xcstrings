    "all time from the first to the last measurement counts, regardless of gaps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب كل الوقت من أول قياس إلى آخر قياس، بغض النظر عن الفجوات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "се брои цялото време от първото до последното измерване, независимо от празнините."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "compta tot el temps des de la primera fins a l’última mesura, sense tenir en compte els buits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "počítá se veškerý čas od prvního do posledního měření bez ohledu na mezery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "tæller al tid fra første til sidste måling, uanset huller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zählt die gesamte Zeit von der ersten bis zur letzten Messung, unabhängig von Lücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "μετρά όλος ο χρόνος από την πρώτη έως την τελευταία μέτρηση, ανεξάρτητα από τα κενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cuenta todo el tiempo desde la primera hasta la última medición, sin importar los huecos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "cuenta todo el tiempo desde la primera hasta la última medición, sin importar los huecos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "lasketaan kaikki aika ensimmäisestä viimeiseen mittaukseen aukoista riippumatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tout le temps de la première à la dernière mesure compte, malgré les lacunes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הזמן מהמדידה הראשונה עד האחרונה נספר, ללא קשר לפערים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से अंतिम माप तक का सारा समय गिना जाता है, अंतराल चाहे जो हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "broji se sve vrijeme od prvog do zadnjeg mjerenja, bez obzira na praznine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "az első és az utolsó mérés közötti teljes idő számít, a hiányoktól függetlenül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "seluruh waktu dari pengukuran pertama hingga terakhir dihitung, terlepas dari celah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "conta tutto il tempo dalla prima all’ultima misurazione, indipendentemente dalle lacune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初から最後の測定値までのすべての時間を、欠測に関係なくカウントします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공백과 관계없이 첫 측정값부터 마지막 측정값까지 모든 시간이 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "įskaičiuojamas visas laikas nuo pirmo iki paskutinio matavimo, nepaisant spragų."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "semua masa dari ukuran pertama hingga terakhir dikira, tanpa mengira jurang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "teller all tid fra første til siste måling, uansett hull."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "telt alle tijd van de eerste tot de laatste meting, ongeacht gaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "liczy się cały czas od pierwszego do ostatniego pomiaru, niezależnie od luk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "todo o tempo da primeira à última medição conta, independentemente das lacunas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "conta todo o tempo da primeira à última medição, independentemente das falhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "se ia în calcul tot timpul de la prima la ultima măsurătoare, indiferent de goluri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "учитывается все время от первого до последнего измерения, независимо от пропусков."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "počíta sa celý čas od prvého po posledné meranie bez ohľadu na medzery."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "šteje ves čas od prve do zadnje meritve, ne glede na vrzeli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "räknas all tid från första till sista mätningen, oavsett luckor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับเวลาทั้งหมดตั้งแต่การวัดครั้งแรกถึงครั้งสุดท้าย ไม่ว่าจะมีช่องว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilk ölçümden son ölçüme kadar tüm süre, boşluklardan bağımsız sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "враховується весь час від першого до останнього вимірювання, незалежно від пропусків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tính toàn bộ thời gian từ số đo đầu đến số đo cuối, bất kể khoảng trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从首次到末次测量的全部时间都计入，不论空缺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從第一次到最後一次測量的全部時間都計入，不論空缺。"
          }
        }
      }
    },
