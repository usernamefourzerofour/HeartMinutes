    "Measurements during workouts always count.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القياسات أثناء التمارين تُحتسب دائمًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерванията по време на тренировки се броят винаги."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures durant els entrenaments sempre compten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření během tréninků se počítají vždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målinger under workouts tæller altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messungen während Trainings zählen immer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μετρήσεις κατά τις προπονήσεις μετρούν πάντα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mediciones durante los entrenamientos siempre cuentan."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mediciones durante los entrenamientos siempre cuentan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Treenien aikaiset mittaukset lasketaan aina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures pendant les entraînements comptent toujours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדידות במהלך אימונים נספרות תמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट के दौरान के माप हमेशा गिने जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjerenja tijekom treninga uvijek se broje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzés közbeni mérések mindig számítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran selama olahraga selalu dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misurazioni durante gli allenamenti contano sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト中の測定値は常にカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 중 측정값은 항상 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Matavimai treniruočių metu įskaičiuojami visada."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran semasa senaman sentiasa dikira."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Målinger under treningsøkter teller alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metingen tijdens trainingen tellen altijd mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiary podczas treningów liczą się zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medições durante treinos sempre contam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As medições durante os treinos contam sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsurătorile din antrenamente se iau mereu în calcul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерения во время тренировок учитываются всегда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Merania počas tréningov sa počítajú vždy."
          }
        },
