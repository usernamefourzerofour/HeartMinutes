            "state": "translated",
            "value": "כל ההגדרות יחזרו לברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी सेटिंग्ज़ डिफ़ॉल्ट पर लौट आएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve postavke vratit će se na zadane vrijednosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítás visszaáll az alapértelmezésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengaturan akan kembali ke default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni torneranno ai valori predefiniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定がデフォルトに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정이 기본값으로 돌아갑니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi nustatymai bus grąžinti į numatytuosius."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua seting akan kembali kepada lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle innstillinger settes tilbake til standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle instellingen worden teruggezet naar de standaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie ustawienia wrócą do wartości domyślnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ajustes voltarão ao padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as definições voltarão às predefinições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate configurările revin la valorile implicite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки вернутся к значениям по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky nastavenia sa vrátia na predvolené hodnoty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse nastavitve bodo povrnjene na privzete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla inställningar återställs till standard."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าทั้งหมดจะกลับเป็นค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ayarlar varsayılan değerlerine döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі налаштування повернуться до типових значень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả cài đặt sẽ trở về mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置将恢复为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有設定都會恢復為預設值。"
          }
        }
      }
