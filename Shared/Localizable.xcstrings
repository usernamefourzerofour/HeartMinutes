    "%@: %@": {},
    "%lld": {},
    "%lld %%": {},
    "%lld %% of your background measurements (from %@) have no active/resting marking, so they don’t count with “Only when active”. The marking only comes from Apple Watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% من قياسات الخلفية (من %2$@) بلا علامة نشط/راحة، لذلك لا تُحتسب مع «فقط عند النشاط». هذه العلامة تأتي من Apple Watch فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% от фоновите ви измервания (от %2$@) нямат отметка активен/покой, затова не се броят при „Само при активност“. Тази отметка идва само от Apple Watch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$lld %% de les mesures de fons (de %2$@) no té marca d’actiu/repòs, així que no compten amb «Només quan estàs actiu». La marca només la posa l’Apple Watch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% vašich měření na pozadí (z %2$@) nemá označení aktivní/klid, takže se v režimu „Jen při aktivitě“ nezapočítávají. Toto označení přidávají jen Apple Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% af dine baggrundsmålinger (fra %2$@) har ingen markering for aktiv/i ro, så de tæller ikke med »Kun når aktiv«. Markeringen kommer kun fra Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% deiner Hintergrundmessungen (von %2$@) haben keine Markierung aktiv/Ruhe und zählen daher bei „Nur wenn aktiv“ nicht. Die Markierung kommt nur von der Apple Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$lld %% των μετρήσεων παρασκηνίου (από %2$@) δεν έχει σήμανση ενεργός/ηρεμία, οπότε δεν μετρά με «Μόνο όταν είστε ενεργοί». Η σήμανση προέρχεται μόνο από το Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$lld %% de tus mediciones de fondo (de %2$@) no tiene marca de activo/reposo, así que no cuentan con «Solo en actividad». La marca solo la pone el Apple Watch."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$lld %% de tus mediciones de fondo (de %2$@) no tiene marca de activo/reposo, así que no cuentan con «Solo en actividad». La marca solo la pone el Apple Watch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% taustamittauksistasi (lähteestä %2$@) ei ole merkitty aktiiviseksi/levoksi, joten niitä ei lasketa asetuksella ”Vain aktiivisena”. Merkintä tulee vain Apple Watchista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% de vos mesures en arrière-plan (de %2$@) n’ont pas d’indication actif/repos et ne comptent donc pas avec « Seulement si actif ». Cette indication provient uniquement de l’Apple Watch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל־%1$lld %% ממדידות הרקע שלך (מ־%2$@) אין סימון פעיל/מנוחה, ולכן הן לא נספרות עם ״רק כשפעיל״. הסימון מגיע רק מ־Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बैकग्राउंड माप (%2$@ से) में से %1$lld %% पर सक्रिय/आराम का निशान नहीं है, इसलिए वे “केवल सक्रिय होने पर” में नहीं गिने जाते। यह निशान केवल Apple Watch से आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% vaših mjerenja u pozadini (iz %2$@) nema oznaku aktivno/mirovanje pa se ne broje uz „Samo kad je aktivno”. Tu oznaku dodaje samo Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Háttérméréseinek %1$lld %%-a (%2$@ forrásból) nem rendelkezik aktív/nyugalmi jelöléssel, így a „Csak aktív állapotban” beállításnál nem számít. Ezt a jelölést csak az Apple Watch adja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% pengukuran latar belakang Anda (dari %2$@) tidak memiliki tanda aktif/istirahat, sehingga tidak dihitung dengan “Hanya saat aktif”. Tanda ini hanya berasal dari Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$lld %% delle misurazioni di sottofondo (da %2$@) non ha l’indicazione attivo/riposo, quindi non conta con «Solo se attivo». L’indicazione arriva solo da Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドの測定値（%2$@）の%1$lld %%にアクティブ/安静の区別がないため、「アクティブ時のみ」ではカウントされません。この区別はApple Watchからのみ記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 측정값(%2$@)의 %1$lld%%에 활동/휴식 표시가 없어 ‘활동 중일 때만’에서 계산되지 않습니다. 이 표시는 Apple Watch에서만 기록됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% jūsų foninių matavimų (iš %2$@) neturi žymos aktyvus/ramybė, todėl režimu „Tik kai aktyvus“ jie neįskaičiuojami. Šią žymą prideda tik Apple Watch."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ukuran latar anda (daripada %2$@) tiada tanda aktif/rehat, jadi ia tidak dikira dengan “Hanya semasa aktif”. Tanda ini hanya datang daripada Apple Watch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% av bakgrunnsmålingene dine (fra %2$@) mangler markering for aktiv/i ro, så de telles ikke med «Bare når aktiv». Markeringen kommer bare fra Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% van je achtergrondmetingen (van %2$@) heeft geen markering actief/rust en telt dus niet mee bij ‘Alleen als actief’. De markering komt alleen van de Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% Twoich pomiarów w tle (z %2$@) nie ma oznaczenia aktywny/spoczynek, więc nie liczą się w trybie „Tylko przy aktywności”. To oznaczenie pochodzi wyłącznie z Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% das suas medições em segundo plano (de %2$@) não têm marcação de ativo/repouso e não contam com “Só quando ativo”. A marcação vem apenas do Apple Watch."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% das suas medições em segundo plano (de %2$@) não têm marcação de ativo/repouso, por isso não contam com “Só quando ativo”. A marcação vem apenas do Apple Watch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% dintre măsurătorile de fundal (de la %2$@) nu au marcaj activ/repaus, deci nu se iau în calcul cu „Doar când e activ”. Marcajul vine doar de la Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$lld %% ваших фоновых измерений (из %2$@) нет отметки «активен/покой», поэтому они не учитываются в режиме «Только при активности». Эту отметку ставят только Apple Watch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% vašich meraní na pozadí (z %2$@) nemá označenie aktívny/pokoj, takže sa v režime „Len pri aktivite“ nezapočítavajú. Toto označenie pridávajú len Apple Watch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% vaših meritev v ozadju (iz %2$@) nima oznake aktivno/mirovanje, zato se pri »Samo ob aktivnosti« ne štejejo. To oznako doda samo Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% av dina bakgrundsmätningar (från %2$@) saknar markering för aktiv/vila, så de räknas inte med ”Bara när aktiv”. Markeringen kommer bara från Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ของการวัดเบื้องหลังของคุณ (จาก %2$@) ไม่มีเครื่องหมายเคลื่อนไหว/พัก จึงไม่ถูกนับในโหมด “เฉพาะเมื่อเคลื่อนไหว” เครื่องหมายนี้มาจาก Apple Watch เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan ölçümlerinizin %%%1$lld kadarında (%2$@ kaynağından) etkin/dinlenme işareti yok, bu yüzden “Yalnızca etkinken” ile sayılmıyor. Bu işaret yalnızca Apple Watch’tan gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% ваших фонових вимірювань (з %2$@) не мають позначки «активний/спокій», тож вони не враховуються в режимі «Лише при активності». Цю позначку ставить лише Apple Watch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %% số đo nền của bạn (từ %2$@) không có dấu hoạt động/nghỉ, nên không được tính với “Chỉ khi hoạt động”. Dấu này chỉ đến từ Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的后台测量（来自 %2$@）中有 %1$lld %% 没有活跃/静息标记，因此在“仅活跃时”下不计入。该标记只来自 Apple Watch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的背景測量（來自 %2$@）中有 %1$lld %% 沒有活動/靜止標記，因此在「僅限活動中」下不計入。此標記只來自 Apple Watch。"
          }
        }
      }
    },
