    "All heart rate in the zones counts – including high heart rate at rest, e.g. from stress or coffee.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل نبض في النطاقات يُحتسب – حتى النبض المرتفع أثناء الراحة، مثلًا بسبب التوتر أو القهوة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Брои се целият пулс в зоните – дори висок пулс в покой, напр. от стрес или кафе."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compta tota la freqüència a les zones, fins i tot la freqüència alta en repòs, p. ex. per estrès o cafè."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se veškerý tep v zónách – i vysoký tep v klidu, např. ze stresu nebo po kávě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Al puls i zonerne tæller – også høj puls i ro, fx stress eller kaffe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Herzfrequenz in den Zonen zählt – auch hohe Herzfrequenz in Ruhe, z. B. durch Stress oder Kaffee."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρούν όλοι οι παλμοί στις ζώνες – ακόμη και υψηλοί παλμοί σε ηρεμία, π.χ. από άγχος ή καφέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta toda la frecuencia en las zonas, incluso la frecuencia alta en reposo, p. ej., por estrés o café."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta toda la frecuencia en las zonas, incluso la frecuencia alta en reposo, p. ej., por estrés o café."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki alueiden syke lasketaan – myös korkea leposyke, esim. stressin tai kahvin vuoksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute fréquence dans les zones compte – même une fréquence élevée au repos, due au stress ou au café par exemple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל דופק באזורים נספר – גם דופק גבוה במנוחה, למשל מלחץ או מקפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ोन में सारी हृदय गति गिनी जाती है – आराम के समय तनाव या कॉफ़ी से बढ़ी हृदय गति भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broji se sav puls u zonama – i visok puls u mirovanju, npr. zbog stresa ili kave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden pulzus számít a zónákban – még a magas nyugalmi pulzus is, pl. stressz vagy kávé miatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua detak jantung di zona dihitung – termasuk detak tinggi saat istirahat, misalnya karena stres atau kopi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta tutta la frequenza nelle zone – anche quella alta a riposo, ad es. per stress o caffè."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゾーン内のすべての心拍数がカウントされます。ストレスやコーヒーなどによる安静時の高い心拍数も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역 안의 모든 심박수가 계산됩니다. 스트레스나 커피 등으로 인한 안정 시 높은 심박수도 포함됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įskaičiuojamas visas pulsas zonose – net aukštas ramybės pulsas, pvz., dėl streso ar kavos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua kadar denyutan dalam zon dikira – termasuk kadar denyutan tinggi semasa rehat, contohnya akibat tekanan atau kopi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "All puls i sonene teller – også høy puls i ro, f.eks. stress eller kaffe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hartslag in de zones telt – ook een hoge hartslag in rust, bijv. door stress of koffie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy się całe tętno w strefach – także wysokie tętno w spoczynku, np. przez stres lub kawę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda frequência nas zonas conta – inclusive frequência alta em repouso, ex.: por estresse ou café."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta toda a frequência nas zonas – incluindo frequência alta em repouso, p. ex. por stress ou café."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ia în calcul tot pulsul din zone – chiar și pulsul ridicat în repaus, de ex. din cauza stresului sau a cafelei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывается весь пульс в зонах — даже высокий пульс в покое, например от стресса или кофе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počíta sa celý tep v zónach – aj vysoký tep v pokoji, napr. zo stresu alebo po káve."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Šteje ves utrip v območjih – tudi visok utrip v mirovanju, npr. zaradi stresa ali kave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "All puls i zonerna räknas – även hög puls i vila, t.ex. stress eller kaffe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับชีพจรทั้งหมดในโซน – รวมถึงชีพจรสูงขณะพัก เช่น จากความเครียดหรือกาแฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgelerdeki tüm nabız sayılır – dinlenirken stres veya kahve gibi nedenlerle yükselen nabız da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховується весь пульс у зонах — навіть високий пульс у спокої, наприклад від стресу чи кави."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi nhịp tim trong các vùng đều được tính – cả nhịp tim cao khi nghỉ, ví dụ do căng thẳng hay cà phê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区间内的所有心率都计入——包括静息时因压力或咖啡等导致的高心率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內的所有心率都會計入——包括靜止時因壓力或咖啡等造成的高心率。"
          }
        }
      }
    },
    "All settings will be reset to their defaults.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود كل الإعدادات إلى القيم الافتراضية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички настройки ще се върнат към стойностите по подразбиране."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els ajustos tornaran als valors per defecte."
