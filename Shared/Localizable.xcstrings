    "the whole workout counts from start to finish – including before the first and after the last measurement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب التمرين كله من البداية إلى النهاية – حتى قبل أول قياس وبعد آخر قياس."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "се брои цялата тренировка от началото до края – и преди първото, и след последното измерване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "compta tot l’entrenament de principi a fi, fins i tot abans de la primera i després de l’última mesura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "počítá se celý trénink od začátku do konce – i před prvním a po posledním měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "tæller hele workouten fra start til slut – også før første og efter sidste måling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zählt das ganze Training vom Anfang bis zum Ende – auch vor der ersten und nach der letzten Messung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "μετρά όλη η προπόνηση από την αρχή έως το τέλος – ακόμη και πριν από την πρώτη και μετά την τελευταία μέτρηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cuenta todo el entrenamiento de principio a fin, incluso antes de la primera y después de la última medición."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "cuenta todo el entrenamiento de principio a fin, incluso antes de la primera y después de la última medición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "lasketaan koko treeni alusta loppuun – myös ennen ensimmäistä ja jälkeen viimeisen mittauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tout l’entraînement compte du début à la fin – même avant la première et après la dernière mesure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל האימון נספר מתחילתו ועד סופו – גם לפני המדידה הראשונה ואחרי האחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा वर्कआउट शुरू से अंत तक गिना जाता है – पहले माप से पहले और अंतिम माप के बाद भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "broji se cijeli trening od početka do kraja – i prije prvog i nakon zadnjeg mjerenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "a teljes edzés számít az elejétől a végéig – az első mérés előtt és az utolsó után is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "seluruh olahraga dihitung dari awal hingga akhir – termasuk sebelum pengukuran pertama dan setelah yang terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "conta tutto l’allenamento dall’inizio alla fine – anche prima della prima e dopo l’ultima misurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト全体を開始から終了までカウントします（最初の測定値の前と最後の測定値の後も含む）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 측정값 전과 마지막 측정값 후를 포함해 운동 전체가 처음부터 끝까지 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "įskaičiuojama visa treniruotė nuo pradžios iki pabaigos – net prieš pirmą ir po paskutinio matavimo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "seluruh senaman dikira dari mula hingga akhir – termasuk sebelum ukuran pertama dan selepas yang terakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "teller hele økten fra start til slutt – også før første og etter siste måling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "telt de hele training van begin tot eind – ook vóór de eerste en na de laatste meting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "liczy się cały trening od początku do końca – także przed pierwszym i po ostatnim pomiarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o treino inteiro conta do início ao fim – inclusive antes da primeira e depois da última medição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "conta o treino inteiro do início ao fim – incluindo antes da primeira e depois da última medição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "se ia în calcul tot antrenamentul de la început la sfârșit – chiar și înainte de prima și după ultima măsurătoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "учитывается вся тренировка от начала до конца — даже до первого и после последнего измерения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "počíta sa celý tréning od začiatku do konca – aj pred prvým a po poslednom meraní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "šteje celotna vadba od začetka do konca – tudi pred prvo in po zadnji meritvi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "räknas hela passet från start till slut – även före första och efter sista mätningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับทั้งการออกกำลังกายตั้งแต่ต้นจนจบ – รวมถึงก่อนการวัดครั้งแรกและหลังครั้งสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tüm antrenman baştan sona sayılır – ilk ölçümden önce ve son ölçümden sonra da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "враховується все тренування від початку до кінця — навіть до першого й після останнього вимірювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tính cả bài tập từ đầu đến cuối – kể cả trước số đo đầu và sau số đo cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个体能训练从开始到结束都计入——包括首次测量之前和末次测量之后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個體能訓練從開始到結束都計入——包括第一次測量前與最後一次測量後。"
          }
        }
      }
    },
