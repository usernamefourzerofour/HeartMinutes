            "state": "translated",
            "value": "Lahko"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lätt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เบา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhẹ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕度"
          }
        }
      }
    },
    "Like “Active or Exercise ring”, but two active stretches are joined when the pause between them is short – good for e.g. gardening, cleaning and play.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل «نشط أو حلقة التمرين»، لكن تُربط فترتا نشاط عندما تكون الاستراحة قصيرة – مناسب مثلًا للبستنة والتنظيف واللعب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Като „Активност или кръг „Упражнения““, но два активни участъка се свързват при кратка пауза – подходящо напр. за градинарство, почистване и игра."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Actiu o anell d’Exercici», però dos trams actius s’uneixen amb una pausa curta: ideal per a jardineria, neteja i jocs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako „Aktivita nebo kruh Cvičení“, ale dva aktivní úseky se při krátké pauze spojí – vhodné např. pro práci na zahradě, úklid a hraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som »Aktiv eller træningsring«, men to aktive stykker kædes sammen, når pausen imellem er kort – godt til fx havearbejde, rengøring og leg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „Aktiv oder Trainingsring“, aber zwei aktive Abschnitte werden verbunden, wenn die Pause kurz ist – gut z. B. für Gartenarbeit, Putzen und Spielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όπως το «Ενεργοί ή Δακτύλιος Άσκησης», αλλά δύο ενεργά τμήματα ενώνονται με μικρή παύση – καλό π.χ. για κηπουρική, καθαριότητα και παιχνίδι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Activo o anillo de Ejercicio», pero dos tramos activos se unen cuando la pausa es corta: ideal para jardinería, limpieza o juegos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Activo o anillo de Ejercicio», pero dos tramos activos se unen cuando la pausa es corta: ideal para jardinería, limpieza o juegos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten ”Aktiivinen tai liikuntarengas”, mutta kaksi aktiivista jaksoa yhdistetään, kun tauko on lyhyt – hyvä esim. puutarhatyöhön, siivoukseen ja leikkiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme « Actif ou anneau Exercice », mais deux périodes actives sont reliées si la pause est courte – idéal pour le jardinage, le ménage ou le jeu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמו ״פעיל או טבעת התרגול״, אבל שני קטעים פעילים מחוברים כשההפסקה קצרה – טוב למשל לעבודה בגינה, ניקיון ומשחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“सक्रिय या एक्सरसाइज़ रिंग” जैसा, लेकिन छोटे विराम पर दो सक्रिय हिस्से जोड़ दिए जाते हैं – बागवानी, सफ़ाई और खेल के लिए अच्छा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao „Aktivno ili prsten Vježbanje”, ali se dva aktivna dijela spajaju uz kratku pauzu – dobro npr. za vrtlarenje, čišćenje i igru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint az „Aktív vagy edzésgyűrű”, de rövid szünetnél két aktív szakasz összekapcsolódik – jó pl. kertészkedéshez, takarításhoz és játékhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Aktif atau Cincin Latihan”, tetapi dua bagian aktif digabung saat jeda singkat – cocok untuk berkebun, bersih-bersih, dan bermain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come «Attivo o anello Esercizio», ma due tratti attivi vengono uniti quando la pausa è breve – ideale per giardinaggio, pulizie e gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクティブまたはエクササイズリング」と同様ですが、間の休憩が短ければ2つのアクティブな区間をつなげます。庭仕事、掃除、遊びなどに適しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘활동 또는 운동하기 링’과 같지만, 휴식이 짧으면 두 활동 구간을 연결합니다. 정원 일, 청소, 놀이 등에 적합합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaip „Aktyvus arba treniruotės žiedas“, bet dvi aktyvios atkarpos sujungiamos esant trumpai pertraukai – tinka, pvz., darbui sode, valymui ir žaidimams."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Aktif atau Gelang Senaman”, tetapi dua bahagian aktif disambungkan apabila rehat singkat – sesuai untuk berkebun, mengemas dan bermain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som «Aktiv eller treningsring», men to aktive perioder kobles sammen når pausen er kort – bra for f.eks. hagearbeid, rengjøring og lek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals ‘Actief of trainingsring’, maar twee actieve stukken worden gekoppeld als de pauze kort is – handig voor bijv. tuinieren, schoonmaken en spelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak „Aktywność lub pierścień Ćwiczenia”, ale dwa aktywne odcinki są łączone przy krótkiej przerwie – dobre np. do prac w ogrodzie, sprzątania i zabawy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Ativo ou anel de Exercício”, mas dois trechos ativos são unidos quando a pausa é curta – bom para jardinagem, limpeza e brincadeiras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Ativo ou Anel de Exercício”, mas dois períodos ativos são unidos com uma pausa curta – bom p. ex. para jardinagem, limpezas e brincadeiras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca „Activ sau inelul Exerciții”, dar două segmente active se unesc la o pauză scurtă – bun de ex. pentru grădinărit, curățenie și joacă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как «Активность или кольцо «Упражнения»», но два активных отрезка объединяются при короткой паузе — удобно, например, для работы в саду, уборки и игр."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako „Aktivita alebo krúžok Cvičenie“, ale dva aktívne úseky sa pri krátkej pauze spoja – vhodné napr. na prácu v záhrade, upratovanie a hru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kot »Aktivno ali obroč Vadba«, vendar se dva aktivna dela ob kratkem premoru povežeta – primerno npr. za vrtnarjenje, čiščenje in igro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som ”Aktiv eller träningsring”, men två aktiva perioder kopplas ihop när pausen är kort – bra för t.ex. trädgårdsarbete, städning och lek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือน “เคลื่อนไหวหรือวงแหวนออกกำลังกาย” แต่จะเชื่อมสองช่วงที่เคลื่อนไหวเมื่อพักสั้น – เหมาะกับการทำสวน ทำความสะอาด และเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Etkin veya Egzersiz halkası” gibi, ancak mola kısa olduğunda iki etkin bölüm birleştirilir – örneğin bahçe işi, temizlik ve oyun için iyi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як «Активність або кільце «Вправи»», але два активні відрізки обʼєднуються при короткій паузі — зручно, наприклад, для роботи в саду, прибирання та ігор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống “Hoạt động hoặc Vòng Bài tập”, nhưng hai đoạn hoạt động được nối khi nghỉ ngắn – phù hợp cho làm vườn, dọn dẹp và vui chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同“活跃或锻炼圆环”，但若暂停很短则将两段活跃时间连在一起——适合园艺、清洁和玩耍等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與「活動中或運動圓圈」相同，但暫停很短時會將兩段活動連在一起——適合園藝、清潔和遊戲等。"
          }
        }
      }
    },
    "Like “Only when active”, but two active stretches are joined when the pause between them is short – without the Exercise ring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل «فقط عند النشاط»، لكن تُربط فترتا نشاط عندما تكون الاستراحة بينهما قصيرة – بدون حلقة التمرين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Като „Само при активност“, но два активни участъка се свързват, когато паузата между тях е кратка – без кръга „Упражнения“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Només quan estàs actiu», però dos trams actius s’uneixen quan la pausa entre ells és curta, sense l’anell d’Exercici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako „Jen při aktivitě“, ale dva aktivní úseky se spojí, když je pauza mezi nimi krátká – bez kruhu Cvičení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som »Kun når aktiv«, men to aktive stykker kædes sammen, når pausen imellem er kort – uden træningsringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „Nur wenn aktiv“, aber zwei aktive Abschnitte werden verbunden, wenn die Pause dazwischen kurz ist – ohne Trainingsring."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όπως το «Μόνο όταν είστε ενεργοί», αλλά δύο ενεργά τμήματα ενώνονται όταν η παύση ανάμεσά τους είναι μικρή – χωρίς τον Δακτύλιο Άσκησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Solo en actividad», pero dos tramos activos se unen cuando la pausa entre ellos es corta, sin el anillo de Ejercicio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Solo en actividad», pero dos tramos activos se unen cuando la pausa entre ellos es corta, sin el anillo de Ejercicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten ”Vain aktiivisena”, mutta kaksi aktiivista jaksoa yhdistetään, kun tauko on lyhyt – ilman liikuntarengasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme « Seulement si actif », mais deux périodes actives sont reliées si la pause est courte – sans l’anneau Exercice."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמו ״רק כשפעיל״, אבל שני קטעים פעילים מחוברים כשההפסקה ביניהם קצרה – בלי טבעת התרגול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“केवल सक्रिय होने पर” जैसा, लेकिन छोटे विराम होने पर दो सक्रिय हिस्से जोड़ दिए जाते हैं – एक्सरसाइज़ रिंग के बिना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao „Samo kad je aktivno”, ali se dva aktivna dijela spajaju kad je pauza između njih kratka – bez prstena Vježbanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint a „Csak aktív állapotban”, de két aktív szakasz összekapcsolódik, ha köztük rövid a szünet – edzésgyűrű nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Hanya saat aktif”, tetapi dua bagian aktif digabung jika jeda di antaranya singkat – tanpa Cincin Latihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come «Solo se attivo», ma due tratti attivi vengono uniti quando la pausa è breve – senza l’anello Esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクティブ時のみ」と同様ですが、間の休憩が短ければ2つのアクティブな区間をつなげます（エクササイズリングは使いません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘활동 중일 때만’과 같지만, 사이의 휴식이 짧으면 두 활동 구간을 연결합니다(운동하기 링 제외)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaip „Tik kai aktyvus“, bet dvi aktyvios atkarpos sujungiamos, kai pertrauka tarp jų trumpa – be treniruotės žiedo."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Hanya semasa aktif”, tetapi dua bahagian aktif disambungkan apabila rehat di antaranya singkat – tanpa Gelang Senaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som «Bare når aktiv», men to aktive perioder kobles sammen når pausen imellom er kort – uten treningsringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals ‘Alleen als actief’, maar twee actieve stukken worden gekoppeld als de pauze ertussen kort is – zonder trainingsring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak „Tylko przy aktywności”, ale dwa aktywne odcinki są łączone, gdy przerwa między nimi jest krótka – bez pierścienia Ćwiczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Só quando ativo”, mas dois trechos ativos são unidos quando a pausa é curta – sem o anel de Exercício."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Só quando ativo”, mas dois períodos ativos são unidos quando a pausa entre eles é curta – sem o Anel de Exercício."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca „Doar când e activ”, dar două segmente active se unesc când pauza dintre ele e scurtă – fără inelul Exerciții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как «Только при активности», но два активных отрезка объединяются, если пауза между ними короткая, — без кольца «Упражнения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako „Len pri aktivite“, ale dva aktívne úseky sa spoja, keď je pauza medzi nimi krátka – bez krúžku Cvičenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kot »Samo ob aktivnosti«, vendar se dva aktivna dela povežeta, ko je premor med njima kratek – brez obroča Vadba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som ”Bara när aktiv”, men två aktiva perioder kopplas ihop när pausen emellan är kort – utan träningsringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือน “เฉพาะเมื่อเคลื่อนไหว” แต่จะเชื่อมสองช่วงที่เคลื่อนไหวเมื่อช่วงพักสั้น – โดยไม่ใช้วงแหวนออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca etkinken” gibi, ancak aradaki mola kısa olduğunda iki etkin bölüm birleştirilir – Egzersiz halkası olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як «Лише при активності», але два активні відрізки обʼєднуються, якщо пауза між ними коротка, — без кільця «Вправи»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống “Chỉ khi hoạt động”, nhưng hai đoạn hoạt động được nối khi khoảng nghỉ ngắn – không dùng Vòng Bài tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同“仅活跃时”，但若两段活跃时间之间的暂停很短则连在一起——不使用锻炼圆环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與「僅限活動中」相同，但若兩段活動之間的暫停很短則連在一起——不使用運動圓圈。"
          }
        }
      }
    },
    "Like “Only when active”, plus the minutes that count in the green Exercise ring (heart rate and movement).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل «فقط عند النشاط»، بالإضافة إلى الدقائق المحتسبة في حلقة التمرين الخضراء (النبض والحركة)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Като „Само при активност“, плюс минутите, които се броят в зеления кръг „Упражнения“ (пулс и движение)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Només quan estàs actiu», més els minuts que compten a l’anell verd d’Exercici (freqüència i moviment)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako „Jen při aktivitě“, plus minuty započítané do zeleného kruhu Cvičení (tep a pohyb)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som »Kun når aktiv«, plus de minutter, der tæller i den grønne træningsring (puls og bevægelse)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „Nur wenn aktiv“, plus die Minuten, die im grünen Trainingsring zählen (Herzfrequenz und Bewegung)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όπως το «Μόνο όταν είστε ενεργοί», συν τα λεπτά που μετρούν στον πράσινο Δακτύλιο Άσκησης (παλμοί και κίνηση)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Solo en actividad», más los minutos que cuentan en el anillo verde de Ejercicio (frecuencia y movimiento)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Como «Solo en actividad», más los minutos que cuentan en el anillo verde de Ejercicio (frecuencia y movimiento)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten ”Vain aktiivisena”, sekä minuutit, jotka lasketaan vihreään liikuntarenkaaseen (syke ja liike)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme « Seulement si actif », plus les minutes comptées dans l’anneau Exercice vert (fréquence et mouvement)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמו ״רק כשפעיל״, ובנוסף הדקות שנספרות בטבעת התרגול הירוקה (דופק ותנועה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“केवल सक्रिय होने पर” जैसा, साथ में वे मिनट जो हरी एक्सरसाइज़ रिंग में गिने जाते हैं (हृदय गति और गति)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao „Samo kad je aktivno”, plus minute koje se broje u zelenom prstenu Vježbanje (puls i pokret)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint a „Csak aktív állapotban”, plusz a zöld edzésgyűrűbe számító percek (pulzus és mozgás)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Hanya saat aktif”, ditambah menit yang dihitung di Cincin Latihan hijau (detak jantung dan gerakan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come «Solo se attivo», più i minuti che contano nell’anello verde Esercizio (frequenza e movimento)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクティブ時のみ」に加え、緑のエクササイズリングにカウントされる分（心拍数と動き）も含みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘활동 중일 때만’에 더해 녹색 운동하기 링에 계산되는 분(심박수와 움직임)도 포함합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaip „Tik kai aktyvus“, plius minutės, įskaičiuojamos į žalią treniruotės žiedą (pulsas ir judėjimas)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti “Hanya semasa aktif”, ditambah minit yang dikira dalam Gelang Senaman hijau (kadar denyutan dan pergerakan)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som «Bare når aktiv», pluss minuttene som teller i den grønne treningsringen (puls og bevegelse)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals ‘Alleen als actief’, plus de minuten die meetellen in de groene trainingsring (hartslag en beweging)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak „Tylko przy aktywności”, plus minuty liczone w zielonym pierścieniu Ćwiczenia (tętno i ruch)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Só quando ativo”, mais os minutos que contam no anel verde de Exercício (frequência e movimento)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “Só quando ativo”, mais os minutos que contam no Anel de Exercício verde (frequência e movimento)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca „Doar când e activ”, plus minutele care contează în inelul verde Exerciții (puls și mișcare)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как «Только при активности», плюс минуты, засчитанные в зеленое кольцо «Упражнения» (пульс и движение)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako „Len pri aktivite“, plus minúty započítané do zeleného krúžku Cvičenie (tep a pohyb)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kot »Samo ob aktivnosti«, poleg tega minute, ki štejejo v zeleni obroč Vadba (utrip in gibanje)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som ”Bara när aktiv”, plus de minuter som räknas i den gröna träningsringen (puls och rörelse)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือน “เฉพาะเมื่อเคลื่อนไหว” บวกนาทีที่นับในวงแหวนออกกำลังกายสีเขียว (ชีพจรและการเคลื่อนไหว)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca etkinken” gibi, ayrıca yeşil Egzersiz halkasında sayılan dakikalar (nabız ve hareket)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як «Лише при активності», плюс хвилини, зараховані в зелене кільце «Вправи» (пульс і рух)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống “Chỉ khi hoạt động”, cộng thêm số phút được tính vào Vòng Bài tập màu xanh (nhịp tim và chuyển động)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同“仅活跃时”，另加计入绿色锻炼圆环的分钟（心率与运动）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與「僅限活動中」相同，另加計入綠色運動圓圈的分鐘（心率與動作）。"
          }
        }
      }
    },
