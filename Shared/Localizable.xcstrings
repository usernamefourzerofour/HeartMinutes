    "Turn on background measurements or workouts at the top of Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل قياسات الخلفية أو التمارين في أعلى الإعدادات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете фоновите измервания или тренировките в горната част на Настройки."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa les mesures de fons o els entrenaments a la part superior de Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte měření na pozadí nebo tréninky nahoře v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå baggrundsmålinger eller workouts til øverst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Hintergrundmessungen oder Trainings oben in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις μετρήσεις παρασκηνίου ή τις προπονήσεις στην κορυφή των Ρυθμίσεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las mediciones de fondo o los entrenamientos en la parte superior de Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las mediciones de fondo o los entrenamientos en la parte superior de Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota taustamittaukset tai treenit käyttöön Asetusten yläosassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les mesures en arrière-plan ou les entraînements en haut des Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו מדידות ברקע או אימונים בראש ההגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में सबसे ऊपर बैकग्राउंड माप या वर्कआउट चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite mjerenja u pozadini ili treninge na vrhu Postavki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a háttérméréseket vagy az edzéseket a Beállítások tetején."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan pengukuran latar belakang atau olahraga di bagian atas Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le misurazioni di sottofondo o gli allenamenti in cima alle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の一番上でバックグラウンドの測定値またはワークアウトをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 맨 위에서 백그라운드 측정 또는 운동을 켜십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite foninius matavimus arba treniruotes Nustatymų viršuje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan ukuran latar atau senaman di bahagian atas Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på bakgrunnsmålinger eller treningsøkter øverst i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet achtergrondmetingen of trainingen aan bovenaan in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz pomiary w tle lub treningi na górze Ustawień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as medições em segundo plano ou os treinos no topo dos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as medições em segundo plano ou os treinos no topo das Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați măsurătorile de fundal sau antrenamentele în partea de sus a Configurărilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите фоновые измерения или тренировки в начале Настроек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite merania na pozadí alebo tréningy hore v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite meritve v ozadju ali vadbe na vrhu Nastavitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på bakgrundsmätningar eller träningspass högst upp i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการวัดเบื้องหลังหรือการออกกำลังกายที่ด้านบนของการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’ın en üstünden arka plan ölçümlerini veya antrenmanları açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть фонові вимірювання або тренування на початку Налаштувань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật số đo nền hoặc bài tập ở đầu Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置顶部打开后台测量或体能训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」最上方開啟背景測量或體能訓練。"
          }
        }
      }
    },
