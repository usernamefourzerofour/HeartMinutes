        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिल का किनारा साप्ताहिक लक्ष्य की ओर भरता है, बीच में मिनट।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrub srca puni se prema tjednom cilju, s minutama u sredini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szív körvonala a heti cél felé telik, középen a percekkel."
