    "A ring that fills towards the weekly goal and keeps going past 100 %, with minutes in the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلقة تمتلئ نحو هدف الأسبوع وتستمر بعد 100 %، مع الدقائق في الوسط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кръг, който се пълни към седмичната цел и продължава след 100 %, с минути в средата."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anell que s’omple cap a l’objectiu setmanal i continua més enllà del 100 %, amb els minuts al centre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kruh, který se plní k týdennímu cíli a pokračuje přes 100 %, s minutami uprostřed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring, der fyldes mod ugens mål og fortsætter rundt over 100 %, med minutter i midten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ring, der sich zum Wochenziel füllt und über 100 % weiterläuft, mit Minuten in der Mitte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δακτύλιος που γεμίζει προς τον εβδομαδιαίο στόχο και συνεχίζει πέρα από το 100 %, με τα λεπτά στο κέντρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo que se llena hacia el objetivo semanal y sigue más allá del 100 %, con los minutos en el centro."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo que se llena hacia el objetivo semanal y sigue más allá del 100 %, con los minutos en el centro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengas, joka täyttyy kohti viikkotavoitetta ja jatkaa yli 100 %:n, minuutit keskellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau qui se remplit vers l’objectif hebdomadaire et continue au-delà de 100 %, avec les minutes au centre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טבעת שמתמלאת לקראת היעד השבועי וממשיכה מעבר ל־100 %, עם דקות במרכז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साप्ताहिक लक्ष्य की ओर भरती और 100 % के बाद भी घूमती रिंग, बीच में मिनट।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prsten koji se puni prema tjednom cilju i nastavlja iza 100 %, s minutama u sredini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűrű, amely a heti cél felé telik, és 100 % felett is tovább halad, középen a percekkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin yang terisi menuju target mingguan dan terus berputar melewati 100 %, dengan menit di tengah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello che si riempie verso l’obiettivo settimanale e prosegue oltre il 100 %, con i minuti al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週の目標に向かって満ち、100 %を超えても回り続けるリング。中央に分数を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 목표를 향해 채워지고 100%를 넘어서도 계속 도는 링, 가운데에 분 표시."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiedas, kuris pildosi iki savaitės tikslo ir tęsiasi po 100 %, su minutėmis viduryje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelang yang terisi ke arah sasaran mingguan dan terus berpusing melepasi 100 %, dengan minit di tengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring som fylles mot ukens mål og fortsetter rundt over 100 %, med minutter i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ring die vol loopt richting het weekdoel en doorgaat boven 100 %, met minuten in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień wypełnia się do celu tygodniowego i biegnie dalej po 100 %, z minutami w środku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel que se enche rumo à meta semanal e continua além de 100 %, com os minutos no centro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel que se enche rumo ao objetivo semanal e continua para lá dos 100 %, com os minutos ao centro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inel care se umple spre obiectivul săptămânal și continuă peste 100 %, cu minutele în centru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо заполняется к недельной цели и продолжает идти после 100 %, минуты в центре."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krúžok, ktorý sa plní k týždennému cieľu a pokračuje cez 100 %, s minútami v strede."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroč, ki se polni proti tedenskemu cilju in nadaljuje čez 100 %, z minutami na sredini."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring som fylls mot veckans mål och fortsätter runt över 100 %, med minuter i mitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนที่เติมไปยังเป้าหมายรายสัปดาห์และวนต่อเกิน 100 % พร้อมนาทีตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık hedefe doğru dolan ve %100’ü geçince devam eden halka; ortada dakika."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце заповнюється до тижневої мети й продовжує після 100 %, хвилини в центрі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng lấp đầy dần đến mục tiêu tuần và tiếp tục quá 100 %, số phút ở giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝每周目标填充、超过 100 % 后继续绕圈的圆环，中间显示分钟数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朝每週目標填滿、超過 100 % 後繼續繞圈的圓圈，中間顯示分鐘數。"
          }
        }
      }
    },
