    "Active when Apple Watch has marked the measurement “active” (mostly based on steps and movement).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشط عندما تكون Apple Watch قد وسمت القياس بـ «نشط» (يعتمد غالبًا على الخطوات والحركة)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен, когато Apple Watch е отбелязал измерването като „активно“ (главно по стъпки и движение)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actiu quan l’Apple Watch ha marcat la mesura com a «activa» (sobretot segons passos i moviment)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní, když Apple Watch označily měření jako „aktivní“ (hlavně podle kroků a pohybu)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv, når Apple Watch har markeret målingen »aktiv« (bygger mest på skridt og bevægelse)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv, wenn die Apple Watch die Messung als „aktiv“ markiert hat (beruht vor allem auf Schritten und Bewegung)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργός όταν το Apple Watch έχει σημειώσει τη μέτρηση ως «ενεργή» (κυρίως βάσει βημάτων και κίνησης)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo cuando el Apple Watch ha marcado la medición como «activa» (sobre todo según pasos y movimiento)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo cuando el Apple Watch ha marcado la medición como «activa» (sobre todo según pasos y movimiento)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivinen, kun Apple Watch on merkinnyt mittauksen ”aktiiviseksi” (perustuu lähinnä askeliin ja liikkeeseen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif quand l’Apple Watch a indiqué la mesure comme « active » (surtout d’après les pas et le mouvement)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעיל כש־Apple Watch סימן את המדידה כ״פעילה״ (מבוסס בעיקר על צעדים ותנועה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय, जब Apple Watch ने माप को “सक्रिय” चिह्नित किया हो (ज़्यादातर कदमों और गति पर आधारित)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno kad je Apple Watch označio mjerenje kao „aktivno” (uglavnom prema koracima i pokretu)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív, ha az Apple Watch „aktívnak” jelölte a mérést (főleg lépések és mozgás alapján)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif saat Apple Watch menandai pengukuran sebagai “aktif” (sebagian besar berdasarkan langkah dan gerakan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo quando Apple Watch ha segnato la misurazione come «attiva» (soprattutto in base a passi e movimento)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchが測定値を「アクティブ」と判定したとき（主に歩数と動きに基づく）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch가 측정값을 ‘활동’으로 표시했을 때 활동 중(주로 걸음 수와 움직임 기반)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktyvus, kai Apple Watch pažymėjo matavimą kaip „aktyvų“ (daugiausia pagal žingsnius ir judėjimą)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif apabila Apple Watch menandakan ukuran sebagai “aktif” (kebanyakannya berdasarkan langkah dan pergerakan)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv når Apple Watch har markert målingen «aktiv» (bygger mest på skritt og bevegelse)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actief als de Apple Watch de meting als ‘actief’ heeft gemarkeerd (vooral op basis van stappen en beweging)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny, gdy Apple Watch oznaczył pomiar jako „aktywny” (głównie na podstawie kroków i ruchu)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo quando o Apple Watch marcou a medição como “ativa” (principalmente por passos e movimento)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo quando o Apple Watch marcou a medição como “ativa” (sobretudo com base em passos e movimento)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activ când Apple Watch a marcat măsurătoarea ca „activă” (mai ales pe baza pașilor și mișcării)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен, когда Apple Watch отметили измерение как «активное» (в основном по шагам и движению)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktívny, keď Apple Watch označili meranie ako „aktívne“ (hlavne podľa krokov a pohybu)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno, ko je Apple Watch meritev označil kot »aktivno« (večinoma glede na korake in gibanje)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv när Apple Watch har markerat mätningen ”aktiv” (bygger mest på steg och rörelse)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวเมื่อ Apple Watch ระบุการวัดว่า “เคลื่อนไหว” (ส่วนใหญ่อิงจากก้าวและการเคลื่อนไหว)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ölçümü “etkin” olarak işaretlediğinde etkin (çoğunlukla adım ve harekete dayanır)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний, коли Apple Watch позначив вимірювання як «активне» (переважно за кроками й рухом)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động khi Apple Watch đánh dấu số đo là “hoạt động” (chủ yếu dựa trên bước và chuyển động)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Apple Watch 将测量标记为“活跃”时（主要基于步数和运动）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Apple Watch 將測量標記為「活動中」時（主要依據步數與動作）。"
          }
        }
      }
    },
    "Active when Apple Watch has marked the measurement “active”, or the minute counts in the Exercise ring.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشط عندما تكون Apple Watch قد وسمت القياس بـ «نشط»، أو تُحتسب الدقيقة في حلقة التمرين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен, когато Apple Watch е отбелязал измерването като „активно“ или минутата се брои в кръга „Упражнения“."
          }
        },
        "ca": {
          "stringUnit": {
