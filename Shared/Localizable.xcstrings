    "Turn off “Only when active”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف «فقط عند النشاط»"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключване на „Само при активност“"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva «Només quan estàs actiu»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnout „Jen při aktivitě“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå »Kun når aktiv« fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur wenn aktiv“ ausschalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποίηση «Μόνο όταν είστε ενεργοί»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar «Solo en actividad»"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar «Solo en actividad»"
          }
        },
        "fi": {
          "stringUnit": {
