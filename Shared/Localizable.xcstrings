    "Make sure Heart Minutes has access in the Health app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن Heart Minutes لديه إذن في تطبيق صحتي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверете дали Heart Minutes има достъп в приложението Здраве."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que Heart Minutes té accés a l’app Salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte, že má Heart Minutes přístup v aplikaci Zdraví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek at Heart Minutes har adgang i Sundhed-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass Heart Minutes in der Health-App Zugriff hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι το Heart Minutes έχει πρόσβαση στην εφαρμογή Υγεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que Heart Minutes tiene acceso en la app Salud."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que Heart Minutes tiene acceso en la app Salud."
          }
        },
        "fi": {
