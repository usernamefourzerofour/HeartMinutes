          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní, když Apple Watch označily měření jako „aktivní“ nebo se minuta počítá do kruhu Cvičení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv, når enten Apple Watch har markeret målingen »aktiv«, eller minuttet tæller i træningsringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv, wenn die Apple Watch die Messung als „aktiv“ markiert hat oder die Minute im Trainingsring zählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργός όταν το Apple Watch έχει σημειώσει τη μέτρηση ως «ενεργή» ή το λεπτό μετρά στον Δακτύλιο Άσκησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo cuando el Apple Watch ha marcado la medición como «activa» o el minuto cuenta en el anillo de Ejercicio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo cuando el Apple Watch ha marcado la medición como «activa» o el minuto cuenta en el anillo de Ejercicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivinen, kun Apple Watch on merkinnyt mittauksen ”aktiiviseksi” tai minuutti lasketaan liikuntarenkaaseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif quand l’Apple Watch a indiqué la mesure comme « active », ou quand la minute compte dans l’anneau Exercice."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעיל כש־Apple Watch סימן את המדידה כ״פעילה״, או כשהדקה נספרת בטבעת התרגול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय, जब Apple Watch ने माप को “सक्रिय” चिह्नित किया हो या वह मिनट एक्सरसाइज़ रिंग में गिना जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno kad je Apple Watch označio mjerenje kao „aktivno” ili se minuta broji u prstenu Vježbanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív, ha az Apple Watch „aktívnak” jelölte a mérést, vagy a perc beszámít az edzésgyűrűbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif saat Apple Watch menandai pengukuran sebagai “aktif”, atau menitnya dihitung di Cincin Latihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo quando Apple Watch ha segnato la misurazione come «attiva» o il minuto conta nell’anello Esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchが測定値を「アクティブ」と判定したとき、またはその分がエクササイズリングにカウントされるとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch가 측정값을 ‘활동’으로 표시했거나 해당 분이 운동하기 링에 계산될 때 활동 중."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktyvus, kai Apple Watch pažymėjo matavimą kaip „aktyvų“ arba minutė įskaičiuojama į treniruotės žiedą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif apabila Apple Watch menandakan ukuran sebagai “aktif”, atau minit itu dikira dalam Gelang Senaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv når Apple Watch har markert målingen «aktiv», eller minuttet teller i treningsringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actief als de Apple Watch de meting als ‘actief’ heeft gemarkeerd, of als de minuut meetelt in de trainingsring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny, gdy Apple Watch oznaczył pomiar jako „aktywny” lub minuta liczy się w pierścieniu Ćwiczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo quando o Apple Watch marcou a medição como “ativa” ou o minuto conta no anel de Exercício."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo quando o Apple Watch marcou a medição como “ativa” ou o minuto conta no Anel de Exercício."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activ când Apple Watch a marcat măsurătoarea ca „activă” sau minutul contează în inelul Exerciții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен, когда Apple Watch отметили измерение как «активное» или минута засчитана в кольцо «Упражнения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktívny, keď Apple Watch označili meranie ako „aktívne“ alebo sa minúta počíta do krúžku Cvičenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivno, ko je Apple Watch meritev označil kot »aktivno« ali minuta šteje v obroč Vadba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv när Apple Watch har markerat mätningen ”aktiv” eller minuten räknas i träningsringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวเมื่อ Apple Watch ระบุการวัดว่า “เคลื่อนไหว” หรือนาทีนั้นนับในวงแหวนออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ölçümü “etkin” olarak işaretlediğinde veya dakika Egzersiz halkasında sayıldığında etkin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний, коли Apple Watch позначив вимірювання як «активне» або хвилину зараховано в кільце «Вправи»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động khi Apple Watch đánh dấu số đo là “hoạt động” hoặc phút đó được tính vào Vòng Bài tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Apple Watch 将测量标记为“活跃”，或该分钟计入锻炼圆环时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Apple Watch 將測量標記為「活動中」，或該分鐘計入運動圓圈時。"
          }
        }
      }
    },
