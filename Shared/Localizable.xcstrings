    "Cautious: the time only counts in the zone both measurements reach at least.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذر: يُحتسب الوقت فقط في النطاق الذي يبلغه القياسان على الأقل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпазливо: времето се брои само в зоната, която и двете измервания поне достигат."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudent: el temps només compta a la zona que assoleixen com a mínim totes dues mesures."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opatrně: čas se počítá jen v zóně, které dosáhnou alespoň obě měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsigtig: tiden tæller kun i den zone, begge målinger mindst når."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtig: Die Zeit zählt nur in der Zone, die beide Messungen mindestens erreichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συντηρητικό: ο χρόνος μετρά μόνο στη ζώνη που φτάνουν τουλάχιστον και οι δύο μετρήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudente: el tiempo solo cuenta en la zona que alcanzan como mínimo ambas mediciones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudente: el tiempo solo cuenta en la zona que alcanzan como mínimo ambas mediciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varovainen: aika lasketaan vain alueelle, jonka molemmat mittaukset vähintään saavuttavat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudent : le temps ne compte que dans la zone atteinte au minimum par les deux mesures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהיר: הזמן נספר רק באזור ששתי המדידות מגיעות אליו לפחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतर्क: समय केवल उस ज़ोन में गिना जाता है जिस तक दोनों माप कम से कम पहुँचते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprezno: vrijeme se broji samo u zoni koju oba mjerenja barem dosegnu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Óvatos: az idő csak abban a zónában számít, amelyet mindkét mérés legalább elér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hati-hati: waktu hanya dihitung di zona yang setidaknya dicapai kedua pengukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudente: il tempo conta solo nella zona raggiunta almeno da entrambe le misurazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控えめ：両方の測定値が少なくとも到達しているゾーンでのみ時間をカウントします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보수적: 두 측정값이 모두 최소한 도달한 영역에서만 시간을 계산합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsargiai: laikas įskaičiuojamas tik į zoną, kurią abu matavimai bent pasiekia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati: masa hanya dikira dalam zon yang sekurang-kurangnya dicapai oleh kedua-dua ukuran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsiktig: tiden teller bare i sonen begge målingene minst når."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorzichtig: de tijd telt alleen in de zone die beide metingen minstens halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrożnie: czas liczy się tylko w strefie, którą osiągają co najmniej oba pomiary."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cauteloso: o tempo só conta na zona que as duas medições atingem no mínimo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cauteloso: o tempo só conta na zona que ambas as medições atingem pelo menos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudent: timpul contează doar în zona pe care o ating cel puțin ambele măsurători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожно: время учитывается только в зоне, которой достигают оба измерения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opatrne: čas sa počíta len v zóne, ktorú dosiahnu aspoň obe merania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Previdno: čas šteje samo v območju, ki ga dosežeta vsaj obe meritvi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försiktig: tiden räknas bara i den zon som båda mätningarna minst når."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระมัดระวัง: เวลาจะนับเฉพาะในโซนที่การวัดทั้งสองถึงอย่างน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temkinli: süre yalnızca iki ölçümün de en az ulaştığı bölgede sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обережно: час враховується лише в зоні, якої досягають обидва вимірювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thận trọng: thời gian chỉ được tính trong vùng mà cả hai số đo đều đạt tối thiểu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保守：仅在两次测量都至少达到的区间内计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保守：只在兩次測量都至少達到的區間內計時。"
          }
        }
      }
    },
