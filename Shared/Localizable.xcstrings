        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepi hati terisi menuju target mingguan, dengan menit di tengah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bordo del cuore si riempie verso l’obiettivo settimanale, con i minuti al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートの縁が週の目標に向かって満ちます。中央に分数を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하트 테두리가 주간 목표를 향해 채워지며, 가운데에 분 표시."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Širdies kontūras pildosi iki savaitės tikslo, su minutėmis viduryje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepi hati terisi ke arah sasaran mingguan, dengan minit di tengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertets kant fylles mot ukens mål, med minutter i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rand van het hart loopt vol richting het weekdoel, met minuten in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrys serca wypełnia się do celu tygodniowego, z minutami w środku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A borda do coração se enche rumo à meta semanal, com os minutos no centro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contorno do coração enche-se rumo ao objetivo semanal, com os minutos ao centro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conturul inimii se umple spre obiectivul săptămânal, cu minutele în centru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контур сердца заполняется к недельной цели, минуты в центре."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrys srdca sa plní k týždennému cieľu, s minútami v strede."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rob srca se polni proti tedenskemu cilju, z minutami na sredini."
