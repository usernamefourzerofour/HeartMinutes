    "The first half of the time follows the previous measurement, the second half the next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النصف الأول من الوقت يتبع القياس السابق، والثاني يتبع التالي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първата половина от времето следва предишното измерване, втората – следващото."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera meitat del temps segueix la mesura anterior i la segona, la següent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První polovina času se řídí předchozím měřením, druhá následujícím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første halvdel af tiden følger den forrige måling, anden halvdel den næste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Hälfte der Zeit folgt der vorherigen Messung, die zweite Hälfte der nächsten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρώτο μισό του χρόνου ακολουθεί την προηγούμενη μέτρηση και το δεύτερο την επόμενη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera mitad del tiempo sigue la medición anterior y la segunda, la siguiente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera mitad del tiempo sigue la medición anterior y la segunda, la siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan ensimmäinen puolisko seuraa edellistä mittausta, toinen seuraavaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première moitié du temps suit la mesure précédente, la seconde la suivante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החצי הראשון של הזמן לפי המדידה הקודמת, והשני לפי הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय का पहला आधा पिछले माप के अनुसार, दूसरा आधा अगले माप के अनुसार।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prva polovica vremena prati prethodno mjerenje, druga sljedeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az idő első fele az előző, második fele a következő mérést követi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Separuh pertama waktu mengikuti pengukuran sebelumnya, separuh kedua pengukuran berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima metà del tempo segue la misurazione precedente, la seconda la successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間の前半は前の測定値、後半は次の測定値に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간의 전반은 이전 측정값, 후반은 다음 측정값을 따릅니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmoji laiko pusė atitinka ankstesnį matavimą, antroji – kitą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Separuh pertama masa mengikut ukuran sebelumnya, separuh kedua mengikut ukuran seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første halvdel av tiden følger forrige måling, andre halvdel neste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste helft van de tijd volgt de vorige meting, de tweede helft de volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza połowa czasu odpowiada poprzedniemu pomiarowi, druga następnemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira metade do tempo segue a medição anterior, a segunda a próxima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira metade do tempo segue a medição anterior e a segunda a seguinte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima jumătate a timpului urmează măsurătoarea anterioară, a doua pe cea următoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая половина времени следует предыдущему измерению, вторая — следующему."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvá polovica času sa riadi predchádzajúcim meraním, druhá nasledujúcim."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prva polovica časa sledi prejšnji meritvi, druga naslednji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första halvan av tiden följer föregående mätning, andra halvan nästa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครึ่งแรกของเวลาตามการวัดก่อนหน้า ครึ่งหลังตามการวัดถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürenin ilk yarısı önceki ölçümü, ikinci yarısı sonrakini izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша половина часу відповідає попередньому вимірюванню, друга — наступному."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nửa đầu thời gian theo số đo trước, nửa sau theo số đo sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前半段时间按上一次测量，后半段按下一次测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前半段時間依上一次測量，後半段依下一次測量。"
          }
        }
      }
    },
    "The highest heart rate your heart can reach – e.g. measured in a test or the same as in another app. Default: 220 − your age.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى نبض يمكن أن يبلغه قلبك – مثلًا من اختبار أو نفس القيمة في تطبيق آخر. الافتراضي: 220 − عمرك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-високият пулс, който сърцето ви може да достигне – напр. измерен при тест или същият като в друго приложение. По подразбиране: 220 − възрастта ви."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La freqüència més alta que pot assolir el teu cor, p. ex. mesurada en una prova o la mateixa que en una altra app. Per defecte: 220 − la teva edat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvyšší tep, kterého může vaše srdce dosáhnout – např. naměřený při testu nebo stejný jako v jiné aplikaci. Výchozí: 220 − váš věk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den højeste puls, dit hjerte kan nå – fx målt ved en test eller den samme som i en anden app. Standard: 220 − din alder."
