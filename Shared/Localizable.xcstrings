    "During workouts, heart rate may be measured with gaps (e.g. during strength training or with a chest strap).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء التمارين قد يُقاس النبض مع فجوات (مثلًا في تمارين القوة أو مع حزام الصدر)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По време на тренировки пулсът може да се измерва с празнини (напр. при силови тренировки или с гръден колан)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Durant els entrenaments la freqüència es pot mesurar amb buits (p. ex. en força o amb banda pectoral)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během tréninků může být tep měřen s mezerami (např. při posilování nebo s hrudním pásem)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under workouts kan pulsen være målt med pauser (fx ved styrketræning eller med en pulsrem)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während Trainings kann die Herzfrequenz mit Lücken gemessen werden (z. B. beim Krafttraining oder mit einem Brustgurt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις προπονήσεις οι παλμοί μπορεί να μετρώνται με κενά (π.χ. σε ενδυνάμωση ή με ζώνη στήθους)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante los entrenamientos, la frecuencia puede medirse con huecos (p. ej., en fuerza o con banda pectoral)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante los entrenamientos, la frecuencia puede medirse con huecos (p. ej., en fuerza o con banda pectoral)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Treenien aikana syke voidaan mitata aukkoineen (esim. voimaharjoittelussa tai sykevyöllä)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant les entraînements, la fréquence peut être mesurée avec des lacunes (musculation ou ceinture cardio, par exemple)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במהלך אימונים הדופק עשוי להימדד עם פערים (למשל באימון כוח או עם רצועת חזה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट के दौरान हृदय गति अंतराल के साथ मापी जा सकती है (जैसे स्ट्रेंथ ट्रेनिंग या चेस्ट स्ट्रैप के साथ)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijekom treninga puls se može mjeriti s prazninama (npr. kod treninga snage ili s prsnim pojasom)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Edzés közben a pulzus hiányokkal is mérhető (pl. erősítésnél vagy mellkaspánttal)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat olahraga, detak jantung bisa diukur dengan celah (misalnya saat latihan beban atau dengan sabuk dada)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante gli allenamenti la frequenza può essere misurata con lacune (ad es. con pesi o fascia cardio)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト中は心拍数が途切れながら測定されることがあります（筋トレ中や胸ベルト使用時など）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 중에는 심박수가 공백을 두고 측정될 수 있습니다(예: 근력 운동이나 가슴 스트랩 사용 시)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruočių metu pulsas gali būti matuojamas su spragomis (pvz., jėgos treniruotėse ar su krūtinės diržu)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa senaman, kadar denyutan mungkin diukur dengan jurang (contohnya semasa latihan bebanan atau dengan tali dada)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under treningsøkter kan pulsen måles med hull (f.eks. ved styrketrening eller med pulsbelte)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens trainingen kan de hartslag met gaten gemeten worden (bijv. bij krachttraining of met een borstband)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas treningów tętno może być mierzone z lukami (np. przy treningu siłowym lub z pasem na klatkę)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante treinos, a frequência pode ser medida com lacunas (ex.: musculação ou cinta peitoral)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante os treinos, a frequência pode ser medida com falhas (p. ex. em treino de força ou com cinta de peito)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În antrenamente pulsul poate fi măsurat cu goluri (de ex. la forță sau cu centura pectorală)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время тренировок пульс может измеряться с пропусками (например, при силовых нагрузках или с нагрудным датчиком)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas tréningov sa tep môže merať s medzerami (napr. pri posilňovaní alebo s hrudným pásom)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med vadbami se utrip lahko meri z vrzelmi (npr. pri vadbi za moč ali s prsnim pasom)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under träningspass kan pulsen mätas med luckor (t.ex. vid styrketräning eller med pulsband)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างออกกำลังกายอาจวัดชีพจรเป็นช่วงๆ (เช่น ขณะเวทเทรนนิ่งหรือใช้สายรัดหน้าอก)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanlarda nabız boşluklarla ölçülebilir (örneğin kuvvet çalışmasında veya göğüs bandıyla)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час тренувань пульс може вимірюватися з пропусками (наприклад, під час силових вправ або з нагрудним датчиком)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong bài tập, nhịp tim có thể được đo không liên tục (ví dụ khi tập tạ hoặc dùng đai ngực)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体能训练期间心率可能断续测量（例如力量训练或使用胸带时）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體能訓練期間心率可能斷續測量（例如重量訓練或使用胸帶時）。"
          }
        }
      }
    },
    "Each measurement applies back to the previous one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل قياس يسري رجوعًا حتى القياس السابق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко измерване важи назад до предишното."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mesura val enrere fins a l’anterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé měření platí zpětně až k předchozímu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver måling gælder tilbage til den forrige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Messung gilt rückwirkend bis zur vorherigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε μέτρηση ισχύει προς τα πίσω έως την προηγούμενη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medición vale hacia atrás hasta la anterior."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medición vale hacia atrás hasta la anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen mittaus on voimassa taaksepäin edelliseen asti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mesure s’applique jusqu’à la précédente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מדידה תקפה אחורה עד הקודמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर माप पीछे की ओर पिछले माप तक लागू रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako mjerenje vrijedi unatrag do prethodnog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden mérés visszafelé az előzőig érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pengukuran berlaku mundur hingga pengukuran sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni misurazione vale a ritroso fino alla precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各測定値は前の測定値までさかのぼって有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 측정값은 이전 측정값까지 거슬러 유효합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas matavimas galioja atgal iki ankstesnio."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ukuran sah ke belakang hingga ukuran sebelumnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver måling gjelder tilbake til den forrige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke meting geldt terug tot de vorige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy pomiar obowiązuje wstecz do poprzedniego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medição vale de volta até a anterior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medição vale para trás até à anterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare măsurătoare e valabilă înapoi până la cea anterioară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое измерение действует назад до предыдущего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé meranie platí spätne až po predchádzajúce."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka meritev velja nazaj do prejšnje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje mätning gäller tillbaka till den föregående."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวัดแต่ละครั้งมีผลย้อนไปจนถึงครั้งก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ölçüm geriye doğru bir öncekine kadar geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне вимірювання діє назад до попереднього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi số đo có hiệu lực ngược về số đo trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次测量向前有效，直到上一次测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次測量往前有效，直到上一次測量。"
          }
        }
      }
    },
    "Each measurement applies until the next one arrives.": {
      "localizations": {
        "ar": {
