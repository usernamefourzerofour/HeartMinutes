        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka meritev velja, dokler ne pride naslednja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje mätning gäller tills nästa kommer."
          }
