          "stringUnit": {
            "state": "translated",
            "value": "Meritve med vadbami se vedno štejejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mätningar under träningspass räknas alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวัดระหว่างการออกกำลังกายนับเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
