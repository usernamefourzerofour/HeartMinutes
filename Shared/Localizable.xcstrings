    "Age: max heart rate = 220 − age.\nEnter: your own max heart rate, e.g. measured in a test.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العمر: أقصى نبض = 220 − العمر.\nإدخال: أقصى نبض خاص بك، مثلًا من اختبار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възраст: максимален пулс = 220 − възраст.\nВъвеждане: собственият ви максимален пулс, напр. измерен при тест."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Edat: freqüència màxima = 220 − edat.\nIntrodueix: la teva freqüència màxima, p. ex. mesurada en una prova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věk: maximální tep = 220 − věk.\nZadat: váš vlastní maximální tep, např. naměřený při testu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alder: maks-puls = 220 − alder.\nIndtast: din egen maks-puls, fx målt ved en test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter: maximale Herzfrequenz = 220 − Alter.\nEingeben: deine eigene maximale Herzfrequenz, z. B. aus einem Test."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ηλικία: μέγιστοι παλμοί = 220 − ηλικία.\nΕισαγωγή: οι δικοί σας μέγιστοι παλμοί, π.χ. από τεστ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edad: frecuencia máxima = 220 − edad.\nIntroducir: tu propia frecuencia máxima, p. ej., medida en una prueba."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Edad: frecuencia máxima = 220 − edad.\nIntroducir: tu propia frecuencia máxima, p. ej., medida en una prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikä: maksimisyke = 220 − ikä.\nSyötä: oma maksimisykkeesi, esim. testissä mitattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Âge : fréquence maximale = 220 − âge.\nSaisir : votre propre fréquence maximale, mesurée lors d’un test par exemple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גיל: דופק מרבי = 220 − גיל.\nהזנה: הדופק המרבי שלך, למשל ממבחן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयु: अधिकतम हृदय गति = 220 − आयु।\nदर्ज करें: आपकी अपनी अधिकतम हृदय गति, जैसे किसी परीक्षण से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dob: maksimalni puls = 220 − dob.\nUnos: vaš vlastiti maksimalni puls, npr. izmjeren testom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Életkor: maximális pulzus = 220 − életkor.\nMegadás: saját maximális pulzusa, pl. tesztből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usia: detak jantung maks = 220 − usia.\nMasukkan: detak jantung maks Anda sendiri, misalnya dari tes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Età: frequenza massima = 220 − età.\nInserisci: la tua frequenza massima, ad es. misurata con un test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢：最大心拍数 = 220 − 年齢。\n入力：テストなどで測定した自分の最大心拍数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나이: 최대 심박수 = 220 − 나이.\n입력: 테스트 등으로 측정한 본인의 최대 심박수."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amžius: maksimalus pulsas = 220 − amžius.\nĮvesti: jūsų maksimalus pulsas, pvz., išmatuotas testo metu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Umur: kadar denyutan maksimum = 220 − umur.\nMasukkan: kadar denyutan maksimum anda sendiri, contohnya daripada ujian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alder: makspuls = 220 − alder.\nAngi: din egen makspuls, f.eks. målt i en test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeftijd: maximale hartslag = 220 − leeftijd.\nInvoeren: je eigen maximale hartslag, bijv. gemeten bij een test."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiek: tętno maksymalne = 220 − wiek.\nWpisz: własne tętno maksymalne, np. zmierzone w teście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idade: frequência máxima = 220 − idade.\nInserir: sua própria frequência máxima, ex.: medida em um teste."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Idade: frequência máxima = 220 − idade.\nIntroduzir: a sua frequência máxima, p. ex. medida num teste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vârstă: puls maxim = 220 − vârsta.\nIntroducere: propriul puls maxim, de ex. măsurat la un test."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возраст: максимальный пульс = 220 − возраст.\nВвести: ваш собственный максимальный пульс, например по результатам теста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vek: maximálny tep = 220 − vek.\nZadať: váš vlastný maximálny tep, napr. nameraný pri teste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starost: največji utrip = 220 − starost.\nVnos: vaš lastni največji utrip, npr. izmerjen na testu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ålder: maxpuls = 220 − ålder.\nAnge: din egen maxpuls, t.ex. uppmätt i ett test."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อายุ: ชีพจรสูงสุด = 220 − อายุ\nป้อน: ชีพจรสูงสุดของคุณเอง เช่น จากการทดสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş: maksimum nabız = 220 − yaş.\nGir: kendi maksimum nabzınız, örneğin bir testte ölçülen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вік: максимальний пульс = 220 − вік.\nВвести: ваш власний максимальний пульс, наприклад за результатами тесту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuổi: nhịp tim tối đa = 220 − tuổi.\nNhập: nhịp tim tối đa của riêng bạn, ví dụ đo qua bài kiểm tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年龄：最大心率 = 220 − 年龄。\n输入：你自己的最大心率，例如测试测得的数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年齡：最大心率 = 220 − 年齡。\n輸入：你自己的最大心率，例如測驗測得的數值。"
          }
        }
      }
    },
