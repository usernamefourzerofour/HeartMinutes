        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีพจรสูงสุดที่หัวใจของคุณทำได้ – เช่น จากการทดสอบหรือค่าเดียวกับในแอปอื่น ค่าเริ่มต้น: 220 − อายุของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbinizin ulaşabileceği en yüksek nabız – örneğin bir testte ölçülen veya başka bir uygulamadakiyle aynı. Varsayılan: 220 − yaşınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найвищий пульс, якого може досягти ваше серце, — наприклад за результатами тесту або як в іншій програмі. Типово: 220 − ваш вік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp tim cao nhất tim bạn có thể đạt – ví dụ đo qua bài kiểm tra hoặc giống trong ứng dụng khác. Mặc định: 220 − tuổi của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心脏能达到的最高心率——例如测试测得或与其他 App 相同的数值。默认：220 − 你的年龄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心臟能達到的最高心率——例如測驗測得或與其他 App 相同的數值。預設：220 − 你的年齡。"
          }
        }
      }
    },
    "The limits are a percentage of your max heart rate (%lld bpm). The factor is how much one minute in the zone counts; by default the lowest zone doesn’t count (× 0).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحدود نسبة مئوية من أقصى نبض لديك (%lld نبضة/د). المعامل يحدد كم تُحتسب دقيقة في النطاق؛ أدنى نطاق لا يُحتسب افتراضيًا (× 0)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Границите са в проценти от максималния ви пулс (%lld уд./мин). Коефициентът показва колко се брои една минута в зоната; най-ниската зона по подразбиране не се брои (× 0)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els límits són un percentatge de la teva freqüència màxima (%lld ppm). El factor indica quant compta un minut a la zona; per defecte la zona més baixa no compta (× 0)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hranice jsou v procentech vašeho maximálního tepu (%lld tepů/min). Koeficient udává, kolik se počítá jedna minuta v zóně; nejnižší zóna se ve výchozím stavu nepočítá (× 0)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grænserne er i procent af din maks-puls (%lld bpm). Faktoren er, hvor meget ét minut i zonen tæller; den nederste zone tæller som udgangspunkt ikke (× 0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grenzen sind Prozent deiner maximalen Herzfrequenz (%lld S/min). Der Faktor gibt an, wie viel eine Minute in der Zone zählt; die unterste Zone zählt standardmäßig nicht (× 0)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα όρια είναι ποσοστά των μέγιστων παλμών σας (%lld παλμοί/λεπτό). Ο συντελεστής δείχνει πόσο μετρά ένα λεπτό στη ζώνη· η χαμηλότερη ζώνη δεν μετρά από προεπιλογή (× 0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites son un porcentaje de tu frecuencia máxima (%lld lpm). El factor indica cuánto cuenta un minuto en la zona; por defecto, la zona más baja no cuenta (× 0)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites son un porcentaje de tu frecuencia máxima (%lld lpm). El factor indica cuánto cuenta un minuto en la zona; por defecto, la zona más baja no cuenta (× 0)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajat ovat prosentteja maksimisykkeestäsi (%lld bpm). Kerroin kertoo, kuinka paljon minuutti alueella lasketaan; alin alue ei oletuksena lasketa (× 0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites sont en pourcentage de votre fréquence maximale (%lld bpm). Le facteur indique combien compte une minute dans la zone ; par défaut, la zone la plus basse ne compte pas (× 0)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגבולות הם אחוזים מהדופק המרבי שלך (%lld פעימות/דקה). המקדם קובע כמה נספרת דקה באזור; האזור הנמוך ביותר לא נספר כברירת מחדל (× 0)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमाएँ आपकी अधिकतम हृदय गति (%lld bpm) का प्रतिशत हैं। गुणक बताता है कि ज़ोन में एक मिनट कितना गिना जाता है; सबसे निचला ज़ोन डिफ़ॉल्ट रूप से नहीं गिना जाता (× 0)।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Granice su u postocima vašeg maksimalnog pulsa (%lld otk./min). Faktor određuje koliko vrijedi jedna minuta u zoni; najniža se zona prema zadanom ne broji (× 0)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A határok a maximális pulzusa (%lld bpm) százalékában értendők. A szorzó azt mutatja, mennyit ér egy perc a zónában; a legalsó zóna alapértelmezés szerint nem számít (× 0)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas berupa persentase detak jantung maksimal Anda (%lld bpm). Faktor menunjukkan berapa nilai satu menit di zona; zona terendah secara default tidak dihitung (× 0)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti sono una percentuale della tua frequenza massima (%lld bpm). Il fattore indica quanto conta un minuto nella zona; di default la zona più bassa non conta (× 0)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界は最大心拍数（%lld bpm）に対する割合です。係数はゾーン内の1分がどれだけカウントされるかを表し、最も低いゾーンはデフォルトでカウントされません（×0）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경계는 최대 심박수(%lldbpm)에 대한 비율입니다. 계수는 영역 안의 1분이 얼마나 계산되는지를 나타내며, 가장 낮은 영역은 기본적으로 계산되지 않습니다(× 0)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ribos nurodytos procentais nuo jūsų maksimalaus pulso (%lld k./min). Koeficientas nurodo, kiek vertinama viena minutė zonoje; žemiausia zona pagal numatytąjį nustatymą neįskaičiuojama (× 0)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had ialah peratusan kadar denyutan maksimum anda (%lld bpm). Faktor menunjukkan berapa nilai satu minit dalam zon; zon terendah tidak dikira secara lalai (× 0)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Grensene er i prosent av makspulsen din (%lld slag/min). Faktoren er hvor mye ett minutt i sonen teller; den laveste sonen teller som standard ikke (× 0)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grenzen zijn een percentage van je maximale hartslag (%lld bpm). De factor bepaalt hoeveel één minuut in de zone telt; de laagste zone telt standaard niet mee (× 0)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Granice to procent Twojego tętna maksymalnego (%lld ud./min). Mnożnik określa, ile liczy się jedna minuta w strefie; najniższa strefa domyślnie się nie liczy (× 0)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites são uma porcentagem da sua frequência máxima (%lld bpm). O fator indica quanto vale um minuto na zona; por padrão, a zona mais baixa não conta (× 0)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites são uma percentagem da sua frequência máxima (%lld bpm). O fator indica quanto vale um minuto na zona; por predefinição, a zona mais baixa não conta (× 0)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitele sunt procente din pulsul maxim (%lld bpm). Factorul arată cât contează un minut în zonă; zona cea mai joasă nu se ia implicit în calcul (× 0)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Границы указаны в процентах от вашего максимального пульса (%lld уд/мин). Коэффициент показывает, сколько засчитывается одна минута в зоне; нижняя зона по умолчанию не учитывается (× 0)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hranice sú v percentách vášho maximálneho tepu (%lld úderov/min). Koeficient určuje, koľko sa počíta jedna minúta v zóne; najnižšia zóna sa predvolene nepočíta (× 0)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meje so v odstotkih vašega največjega utripa (%lld utripov/min). Faktor določa, koliko šteje ena minuta v območju; najnižje območje privzeto ne šteje (× 0)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gränserna är i procent av din maxpuls (%lld slag/min). Faktorn är hur mycket en minut i zonen räknas; den lägsta zonen räknas som standard inte (× 0)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบเขตเป็นเปอร์เซ็นต์ของชีพจรสูงสุดของคุณ (%lld ครั้ง/นาที) ตัวคูณบอกว่าหนึ่งนาทีในโซนนับเท่าใด โซนต่ำสุดไม่นับตามค่าเริ่มต้น (× 0)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlar maksimum nabzınızın (%lld atım/dk) yüzdesidir. Katsayı, bölgedeki bir dakikanın ne kadar sayıldığını belirtir; en alt bölge varsayılan olarak sayılmaz (× 0)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Межі вказано у відсотках від вашого максимального пульсу (%lld уд/хв). Коефіцієнт показує, скільки зараховується одна хвилина в зоні; нижня зона типово не враховується (× 0)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ngưỡng là phần trăm nhịp tim tối đa của bạn (%lld nhịp/phút). Hệ số cho biết một phút trong vùng được tính bao nhiêu; vùng thấp nhất mặc định không được tính (× 0)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界限为最大心率（%lld 次/分）的百分比。系数表示区间内每分钟计入多少；默认情况下最低区间不计入（× 0）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "界限為最大心率（%lld 次/分）的百分比。係數表示區間內每分鐘計入多少；預設最低區間不計入（× 0）。"
          }
        }
      }
    },
    "The outline of the heart fills towards the weekly goal, with minutes in the middle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمتلئ حافة القلب نحو هدف الأسبوع، مع الدقائق في الوسط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Контурът на сърцето се пълни към седмичната цел, с минути в средата."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La vora del cor s’omple cap a l’objectiu setmanal, amb els minuts al centre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrys srdce se plní k týdennímu cíli, s minutami uprostřed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertets kant fyldes mod ugens mål, med minutter i midten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rand des Herzens füllt sich zum Wochenziel, mit Minuten in der Mitte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περίγραμμα της καρδιάς γεμίζει προς τον εβδομαδιαίο στόχο, με τα λεπτά στο κέντρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borde del corazón se llena hacia el objetivo semanal, con los minutos en el centro."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El borde del corazón se llena hacia el objetivo semanal, con los minutos en el centro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sydämen reuna täyttyy kohti viikkotavoitetta, minuutit keskellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contour du cœur se remplit vers l’objectif hebdomadaire, avec les minutes au centre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולי הלב מתמלאים לקראת היעד השבועי, עם דקות במרכז."
