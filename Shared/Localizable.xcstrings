    "Follows the American Heart Association (AHA) recommendations: moderate 50–70 %, vigorous from 70 % of max heart rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع توصيات جمعية القلب الأمريكية (AHA): معتدل 50–70 %، شديد من 70 % من أقصى نبض."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следва препоръките на Американската сърдечна асоциация (AHA): умерена 50–70 %, интензивна от 70 % от максималния пулс."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix les recomanacions de l’American Heart Association (AHA): moderada 50–70 %, intensa des del 70 % de la freqüència màxima."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle doporučení American Heart Association (AHA): středně intenzivní 50–70 %, intenzivní od 70 % maximálního tepu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger anbefalingerne fra American Heart Association (AHA): moderat 50–70 %, hård fra 70 % af maks-puls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt den Empfehlungen der American Heart Association (AHA): moderat 50–70 %, intensiv ab 70 % der maximalen Herzfrequenz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθεί τις συστάσεις της American Heart Association (AHA): μέτρια 50–70 %, έντονη από 70 % των μέγιστων παλμών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue las recomendaciones de la American Heart Association (AHA): moderada 50–70 %, intensa desde el 70 % de la frecuencia máxima."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue las recomendaciones de la American Heart Association (AHA): moderada 50–70 %, intensa desde el 70 % de la frecuencia máxima."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noudattaa American Heart Associationin (AHA) suosituksia: kohtuullinen 50–70 %, rasittava 70 %:sta maksimisykkeestä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit les recommandations de l’American Heart Association (AHA) : modérée 50–70 %, intense dès 70 % de la fréquence maximale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהתאם להמלצות איגוד הלב האמריקאי (AHA): מתון 50–70 %, מאומץ מ־70 % מהדופק המרבי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमेरिकन हार्ट एसोसिएशन (AHA) की सलाह के अनुसार: मध्यम 50–70 %, तीव्र अधिकतम हृदय गति के 70 % से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prema preporukama American Heart Association (AHA): umjerena 50–70 %, intenzivna od 70 % maksimalnog pulsa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az American Heart Association (AHA) ajánlásait követi: mérsékelt 50–70 %, intenzív a maximális pulzus 70 %-ától."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengikuti rekomendasi American Heart Association (AHA): sedang 50–70 %, berat mulai 70 % dari detak jantung maksimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue le raccomandazioni dell’American Heart Association (AHA): moderata 50–70 %, intensa dal 70 % della frequenza massima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国心臓協会（AHA）の推奨に従います：中程度は最大心拍数の50～70 %、高強度は70 %以上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국심장협회(AHA) 권장 사항을 따릅니다: 중강도 50–70%, 고강도는 최대 심박수의 70%부터."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagal American Heart Association (AHA) rekomendacijas: vidutinė 50–70 %, intensyvi nuo 70 % maksimalaus pulso."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengikut saranan American Heart Association (AHA): sederhana 50–70 %, berat dari 70 % kadar denyutan maksimum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger anbefalingene fra American Heart Association (AHA): moderat 50–70 %, hard fra 70 % av makspuls."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgt de aanbevelingen van de American Heart Association (AHA): matig 50–70 %, zwaar vanaf 70 % van de maximale hartslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgodnie z zaleceniami American Heart Association (AHA): umiarkowana 50–70 %, intensywna od 70 % tętna maksymalnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue as recomendações da American Heart Association (AHA): moderada 50–70 %, intensa a partir de 70 % da frequência máxima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue as recomendações da American Heart Association (AHA): moderada 50–70 %, intensa a partir de 70 % da frequência máxima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmează recomandările American Heart Association (AHA): moderată 50–70 %, intensă de la 70 % din pulsul maxim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует рекомендациям Американской кардиологической ассоциации (AHA): умеренная 50–70 %, интенсивная от 70 % максимального пульса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podľa odporúčaní American Heart Association (AHA): stredne intenzívna 50–70 %, intenzívna od 70 % maximálneho tepu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po priporočilih American Heart Association (AHA): zmerno 50–70 %, intenzivno od 70 % največjega srčnega utripa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följer American Heart Associations (AHA) rekommendationer: måttlig 50–70 %, ansträngande från 70 % av maxpuls."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตามคำแนะนำของสมาคมโรคหัวใจอเมริกัน (AHA): ปานกลาง 50–70 % หนักตั้งแต่ 70 % ของชีพจรสูงสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "American Heart Association (AHA) önerilerini izler: orta %50–70, yoğun maksimum nabzın %70’inden itibaren."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідає рекомендаціям Американської асоціації серця (AHA): помірна 50–70 %, інтенсивна від 70 % максимального пульсу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo khuyến nghị của Hiệp hội Tim mạch Hoa Kỳ (AHA): vừa phải 50–70 %, mạnh từ 70 % nhịp tim tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遵循美国心脏协会 (AHA) 的建议：中等强度为最大心率的 50–70 %，高强度为 70 % 以上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遵循美國心臟協會 (AHA) 的建議：中等強度為最大心率的 50–70 %，高強度為 70 % 以上。"
          }
        }
      }
    },
