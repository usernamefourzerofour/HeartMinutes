    "Tap a workout to see it in the heart rate chart.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على تمرين لعرضه في مخطط النبض."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете тренировка, за да я видите в графиката на пулса."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un entrenament per veure’l al gràfic de freqüència."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na trénink ho zobrazíte v grafu tepu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en workout for at se den i pulsgrafen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Training, um es in der Herzfrequenzgrafik zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε μια προπόνηση για να τη δείτε στο γράφημα παλμών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un entrenamiento para verlo en la gráfica de frecuencia."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un entrenamiento para verlo en la gráfica de frecuencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta treeniä nähdäksesi sen sykekaaviossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un entraînement pour le voir dans le graphique cardiaque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על אימון כדי לראות אותו בגרף הדופק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदय गति ग्राफ़ में देखने के लिए किसी वर्कआउट पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite trening da ga vidite na grafikonu pulsa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson egy edzésre, hogy lássa a pulzusgrafikonon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk olahraga untuk melihatnya di grafik detak jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un allenamento per vederlo nel grafico della frequenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトをタップすると心拍数グラフに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동을 탭하면 심박수 그래프에서 볼 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite treniruotę, kad pamatytumėte ją pulso grafike."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik senaman untuk melihatnya dalam graf kadar denyutan jantung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en treningsøkt for å se den i pulsgrafen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een training om die in de hartslaggrafiek te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij trening, aby zobaczyć go na wykresie tętna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um treino para vê-lo no gráfico de frequência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num treino para o ver no gráfico de frequência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți un antrenament pentru a-l vedea în graficul pulsului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь тренировки, чтобы увидеть ее на графике пульса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na tréning ho zobrazíte v grafe tepu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite vadbo, da jo vidite na grafu srčnega utripa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett träningspass för att se det i pulsdiagrammet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการออกกำลังกายเพื่อดูในกราฟชีพจร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabız grafiğinde görmek için bir antrenmana dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться тренування, щоб побачити його на графіку пульсу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào bài tập để xem trên biểu đồ nhịp tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点体能训练以在心率图中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下體能訓練即可在心率圖中查看。"
          }
        }
      }
    },
    "Tap to see the calculation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لعرض طريقة الحساب"
