          "stringUnit": {
            "state": "translated",
            "value": "Prsten koji se puni prema tjednom cilju i nastavlja iza 100 %, s postotkom u sredini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűrű, amely a heti cél felé telik, és 100 % felett is tovább halad, középen a százalékkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin yang terisi menuju target mingguan dan terus berputar melewati 100 %, dengan persen di tengah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello che si riempie verso l’obiettivo settimanale e prosegue oltre il 100 %, con la percentuale al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週の目標に向かって満ち、100 %を超えても回り続けるリング。中央にパーセントを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 목표를 향해 채워지고 100%를 넘어서도 계속 도는 링, 가운데에 퍼센트 표시."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiedas, kuris pildosi iki savaitės tikslo ir tęsiasi po 100 %, su procentais viduryje."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelang yang terisi ke arah sasaran mingguan dan terus berpusing melepasi 100 %, dengan peratus di tengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring som fylles mot ukens mål og fortsetter rundt over 100 %, med prosent i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ring die vol loopt richting het weekdoel en doorgaat boven 100 %, met procent in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień wypełnia się do celu tygodniowego i biegnie dalej po 100 %, z procentem w środku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel que se enche rumo à meta semanal e continua além de 100 %, com a porcentagem no centro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel que se enche rumo ao objetivo semanal e continua para lá dos 100 %, com a percentagem ao centro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inel care se umple spre obiectivul săptămânal și continuă peste 100 %, cu procentul în centru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо заполняется к недельной цели и продолжает идти после 100 %, проценты в центре."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krúžok, ktorý sa plní k týždennému cieľu a pokračuje cez 100 %, s percentami v strede."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroč, ki se polni proti tedenskemu cilju in nadaljuje čez 100 %, z odstotki na sredini."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring som fylls mot veckans mål och fortsätter runt över 100 %, med procent i mitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนที่เติมไปยังเป้าหมายรายสัปดาห์และวนต่อเกิน 100 % พร้อมเปอร์เซ็นต์ตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık hedefe doğru dolan ve %100’ü geçince devam eden halka; ortada yüzde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце заповнюється до тижневої мети й продовжує після 100 %, відсотки в центрі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng lấp đầy dần đến mục tiêu tuần và tiếp tục quá 100 %, phần trăm ở giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朝每周目标填充、超过 100 % 后继续绕圈的圆环，中间显示百分比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朝每週目標填滿、超過 100 % 後繼續繞圈的圓圈，中間顯示百分比。"
          }
        }
      }
    },
