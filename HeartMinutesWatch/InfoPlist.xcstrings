{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Heart Minutes قياسات النبض والتمارين لعرض Heart Minutes لهذا الأسبوع على ساعتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes чете измерванията на пулса и тренировките, за да покаже Heart Minutes за седмицата на часовника."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes llegeix les mesures de freqüència i els entrenaments per mostrar els Heart Minutes de la setmana al rellotge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes čte měření tepu a tréninky, aby na hodinkách zobrazil Heart Minutes za tento týden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes læser dine pulsmålinger og træninger for at vise ugens Heart Minutes på uret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes liest deine Herzfrequenzmessungen und Trainings, um die Heart Minutes der Woche auf der Uhr zu zeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Heart Minutes διαβάζει τις μετρήσεις παλμών και τις προπονήσεις σας για να δείξει τα Heart Minutes της εβδομάδας στο ρολόι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes lee tus mediciones de frecuencia cardiaca y entrenamientos para mostrar los Heart Minutes de la semana en el reloj."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes lee tus mediciones de frecuencia cardiaca y entrenamientos para mostrar los Heart Minutes de la semana en el reloj."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes lukee sykemittauksesi ja treenisi näyttääkseen viikon Heart Minutesit kellossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes lit vos mesures cardiaques et vos entraînements pour afficher les Heart Minutes de la semaine sur la montre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes קורא את מדידות הדופק והאימונים שלך כדי להציג את ה־Heart Minutes של השבוע בשעון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes हृदय गति के माप और वर्कआउट पढ़ता है ताकि घड़ी पर इस सप्ताह के Heart Minutes दिखा सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes čita mjerenja pulsa i treninge kako bi na satu prikazao ovotjedne Heart Minutes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Heart Minutes beolvassa a pulzusméréseit és edzéseit, hogy az órán mutassa a heti Heart Minutest."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes membaca pengukuran detak jantung dan olahraga untuk menampilkan Heart Minutes minggu ini di jam Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes legge le misurazioni della frequenza cardiaca e gli allenamenti per mostrare gli Heart Minutes della settimana sull’orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutesは心拍数の測定値とワークアウトを読み取り、今週のHeart MinutesをWatchに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes는 심박수 측정값과 운동을 읽어 이번 주 Heart Minutes를 시계에 표시합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes skaito pulso matavimus ir treniruotes, kad laikrodyje parodytų šios savaitės Heart Minutes."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes membaca ukuran kadar denyutan jantung dan senaman untuk memaparkan Heart Minutes minggu ini pada jam anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes leser pulsmålingene og treningsøktene dine for å vise ukens Heart Minutes på klokken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes leest je hartslagmetingen en trainingen om de Heart Minutes van deze week op je horloge te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes odczytuje pomiary tętna i treningi, aby pokazać tygodniowe Heart Minutes na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Heart Minutes lê suas medições de frequência cardíaca e treinos para mostrar os Heart Minutes da semana no relógio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Heart Minutes lê as suas medições de frequência cardíaca e treinos para mostrar os Heart Minutes da semana no relógio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes citește măsurătorile pulsului și antrenamentele pentru a afișa Heart Minutes din săptămâna aceasta pe ceas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes читает измерения пульса и тренировки, чтобы показать Heart Minutes за неделю на часах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes číta merania tepu a tréningy, aby na hodinkách zobrazil Heart Minutes za tento týždeň."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes bere meritve srčnega utripa in vadbe, da na uri prikaže tedenske Heart Minutes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes läser dina pulsmätningar och träningspass för att visa veckans Heart Minutes på klockan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes อ่านการวัดชีพจรและการออกกำลังกายเพื่อแสดง Heart Minutes ของสัปดาห์นี้บนนาฬิกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes, bu haftanın Heart Minutes değerini saatinizde göstermek için nabız ölçümlerinizi ve antrenmanlarınızı okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes читає вимірювання пульсу й тренування, щоб показати Heart Minutes за тиждень на годиннику."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes đọc số đo nhịp tim và bài tập để hiển thị Heart Minutes tuần này trên đồng hồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes 读取你的心率测量和体能训练，以便在手表上显示本周的 Heart Minutes。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes 讀取你的心率測量與體能訓練，以便在手錶上顯示本週的 Heart Minutes。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحفظ Heart Minutes أي بيانات في تطبيق صحتي – بل يقرأ فقط قياسات النبض والتمارين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes не записва данни в Здраве – само чете измерванията на пулса и тренировките ви."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes no desa dades a Salut: només llegeix les teves mesures de freqüència i els teus entrenaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes neukládá do Zdraví žádná data – jen čte vaše měření tepu a tréninky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes gemmer ikke data i Sundhed – den læser kun dine pulsmålinger og træninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes speichert keine Daten in Health – die App liest nur deine Herzfrequenzmessungen und Trainings."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Heart Minutes δεν αποθηκεύει δεδομένα στην Υγεία – μόνο διαβάζει τις μετρήσεις παλμών και τις προπονήσεις σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes no guarda datos en Salud: solo lee tus mediciones de frecuencia cardiaca y tus entrenamientos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes no guarda datos en Salud: solo lee tus mediciones de frecuencia cardiaca y tus entrenamientos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes ei tallenna tietoja Terveys-appiin – se vain lukee sykemittauksesi ja treenisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes n’enregistre aucune donnée dans Santé – l’app lit seulement vos mesures cardiaques et vos entraînements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes לא שומר נתונים ב״בריאות״ – הוא רק קורא את מדידות הדופק והאימונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes स्वास्थ्य में कोई डेटा सहेजता नहीं – यह केवल आपकी हृदय गति के माप और वर्कआउट पढ़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes ne sprema podatke u Zdravlje – samo čita vaša mjerenja pulsa i treninge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Heart Minutes nem ment adatot az Egészség appba – csak beolvassa a pulzusméréseit és edzéseit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes tidak menyimpan data di Kesehatan – hanya membaca pengukuran detak jantung dan olahraga Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes non salva dati in Salute – legge solo le tue misurazioni della frequenza cardiaca e i tuoi allenamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutesはヘルスケアにデータを保存しません。心拍数の測定値とワークアウトを読み取るだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes는 건강 앱에 데이터를 저장하지 않으며, 심박수 측정값과 운동만 읽습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes neišsaugo duomenų „Sveikatoje“ – tik skaito jūsų pulso matavimus ir treniruotes."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes tidak menyimpan data dalam Kesihatan – ia hanya membaca ukuran kadar denyutan jantung dan senaman anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes lagrer ikke data i Helse – appen leser bare pulsmålingene og treningsøktene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes bewaart geen gegevens in Gezondheid – de app leest alleen je hartslagmetingen en trainingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes nie zapisuje danych w aplikacji Zdrowie – tylko odczytuje pomiary tętna i treningi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Heart Minutes não salva dados no Saúde – ele apenas lê suas medições de frequência cardíaca e seus treinos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Heart Minutes não guarda dados na app Saúde – apenas lê as suas medições de frequência cardíaca e treinos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes nu salvează date în Sănătate – doar citește măsurătorile pulsului și antrenamentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes не сохраняет данные в «Здоровье» — только читает ваши измерения пульса и тренировки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes neukladá do Zdravia žiadne údaje – len číta vaše merania tepu a tréningy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes ne shranjuje podatkov v Zdravje – samo bere vaše meritve srčnega utripa in vadbe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes sparar inga data i Hälsa – appen läser bara dina pulsmätningar och träningspass."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes ไม่บันทึกข้อมูลลงในแอปสุขภาพ – เพียงอ่านการวัดชีพจรและการออกกำลังกายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes, Sağlık’a veri kaydetmez – yalnızca nabız ölçümlerinizi ve antrenmanlarınızı okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes не зберігає дані у «Здоровʼї» — лише читає ваші вимірювання пульсу й тренування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes không lưu dữ liệu vào Sức khỏe – chỉ đọc số đo nhịp tim và bài tập của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes 不会在“健康”中存储数据——它只读取你的心率测量和体能训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart Minutes 不會在「健康」中儲存資料——只會讀取你的心率測量與體能訓練。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
